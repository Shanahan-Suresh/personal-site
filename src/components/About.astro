---
import SectionHeading from "./SectionHeading.astro";
import Card from "./Card.astro";
import MediaFrame from "./MediaFrame.astro";
import portrait from "@/assets/scrapbook/portrait-cutout-v4.png";
---

<section id="about" class="section">
  <div class="container">
    <SectionHeading eyebrow="ABOUT" title="The short version" />

    <div class="about-layout">
      <Card class="reveal about-story">
        <div class="stack stack-5">
          <h3 class="h3">
            From wanting to be an inventor to building products
          </h3>
          <div class="stack stack-4">
            <p>
              Long before my first <span class="terminal-text">Hello World</span
              >, I wanted to be an inventor. These days I make things that live
              in code, from bite-sized apps to large systems. Creating something
              from nothing still feels awesome.
            </p>
            <p>
              I think of myself as a product engineer. I enjoy building systems
              and shaping the experience around them. The best products should
              feel <strong>right</strong>.
            </p>
            <p>
              I'm obsessive about polish. Once I spot a rough edge or a bug,
              it's hard to leave it alone.
            </p>
          </div>
        </div>
      </Card>

      <div class="portrait-wrap reveal">
        <MediaFrame
          image={portrait}
          alt="Shanahan Suresh smiling in a navy jacket and white shirt, with a cream outline against a warm-grey background."
          caption="Hello, I'm Shanahan."
          fit="cover"
          aspectRatio="4 / 5"
          widths={[320, 500, 700]}
          sizes="(max-width: 600px) 78vw, (max-width: 820px) 42vw, 28vw"
          class="portrait-frame"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .portrait-wrap {
    width: 100%;
    max-width: 330px;
    justify-self: end;
  }

  :global(.portrait-frame) {
    transform: rotate(-2deg);
  }
  :global(.portrait-frame .media-canvas) {
    background: linear-gradient(145deg, #e2dfd9, #cbc7bf);
    isolation: isolate;
  }
  :global(.portrait-frame .media-canvas img) {
    width: 93%;
    height: 93%;
    margin: 7% auto 0;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(2px 0 0 #fff6e6) drop-shadow(-2px 0 0 #fff6e6)
      drop-shadow(0 -2px 0 #fff6e6) drop-shadow(3px 4px 6px rgb(38 43 49 / 18%));
  }

  .terminal-text {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: #0d0d0d;
    color: #2fbf71;
    padding: 0.08em 0.5em;
    border-radius: 3px;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .terminal-text::before {
    content: "$ ";
    color: #9b958a;
  }

  @media (max-width: 820px) {
    .about-layout {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  @media (max-width: 600px) {
    .about-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .portrait-wrap {
      width: 82%;
      max-width: 300px;
      justify-self: center;
    }
  }
</style>
