---
import Card from './Card.astro';

interface Props {
  span?: 2 | 3 | 4 | 6;
  accent?: '1' | '2' | 'pop' | 'ink';
  stripe?: boolean;
  class?: string;
}

const { span = 2, accent, stripe = false, class: className = '' } = Astro.props;
---

<Card
  accent={accent}
  stripe={stripe}
  press
  class={`col-${span} reveal ${className}`}
>
  <slot />
</Card>
