---
import Card from "./Card.astro";
import type { Accent } from "@/lib/types";

interface Props {
  span?: 2 | 3 | 4 | 6;
  accent?: Accent;
  stripe?: boolean;
  class?: string;
}

const { span = 2, accent, stripe = false, class: className = "" } = Astro.props;
---

<Card
  accent={accent}
  stripe={stripe}
  press
  class={`col-${span} reveal ${className}`}
>
  <slot />
</Card>
