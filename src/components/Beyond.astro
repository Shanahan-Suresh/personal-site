---
import { Image } from "astro:assets";
import { interests } from "@/data/interests";
---

<section class="slab s-tomato" id="beyond" aria-labelledby="beyond-title">
  <h2 id="beyond-title" class="sr-only">When I'm not building</h2>
  <ul class="off" role="list">
    {
      interests.map(
        ({ title, caption, image, alt, objectPosition, credit }) => (
          <li>
            <figure>
              <div class="pic">
                <Image
                  src={image}
                  alt={alt}
                  format="webp"
                  quality={78}
                  widths={[240, 360, 520]}
                  sizes="(max-width: 960px) 50vw, 25vw"
                  loading="lazy"
                  decoding="async"
                  style={
                    objectPosition ? `object-position:${objectPosition}` : ""
                  }
                />
              </div>
              <figcaption>
                <b>{title}</b>
                {caption}
                <span class="media-credit">
                  <a href={credit.href}>{credit.label}</a>
                </span>
              </figcaption>
            </figure>
          </li>
        ),
      )
    }
  </ul>
</section>

<style>
  /* Ink shows through the gaps as the seams, so every tile is the same size. */
  .off {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--seam);
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--ink);
  }
  li {
    background: var(--tomato);
  }
  figure {
    margin: 0;
  }
  /* The photo leans in a little under the pointer, inside its square crop.
     The tile is not a link, so it takes no fill. */
  .pic {
    overflow: hidden;
    border-bottom: var(--seam) solid var(--ink);
  }
  img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    img {
      transition: transform 0.45s var(--ease-out);
    }
    li:hover img {
      transform: scale(1.04);
    }
  }
  figcaption {
    padding: 16px 20px 22px;
    font-size: 16px;
    line-height: 1.4;
  }
  b {
    display: block;
    margin-bottom: 6px;
    font: 800 22px/1 var(--font-display);
    letter-spacing: 0.008em;
    text-transform: uppercase;
  }
  .media-credit {
    display: block;
    margin-top: 10px;
    font: 400 11.5px/1.35 var(--font-mono);
    letter-spacing: 0.02em;
  }
  .media-credit a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    transition: background var(--dur-fast);
  }
  .media-credit a:hover,
  .media-credit a:focus-visible {
    background: var(--ink);
    color: var(--white);
  }
  @media (max-width: 960px) {
    .off {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    figcaption {
      padding: 12px 14px 18px;
      font-size: 15px;
    }
    b {
      font-size: 19px;
    }
  }
</style>
