---
import SectionHeading from "./SectionHeading.astro";
import Card from "./Card.astro";
import { interests } from "@/data/interests";
---

<section class="section" id="beyond">
  <div class="container">
    <SectionHeading eyebrow="BEYOND CODE" title="When I'm not building" />

    <Card accent="2" stripe pad class="reveal" style="--d:0ms">
      <p class="lead" style="max-width:72ch;">
        Outside of work I'm deep into anime, games, and light novels, usually
        half-planning a trip somewhere, and in the gym four evenings a week. Ask
        me about any of it and I can go a while.
      </p>

      <div class="row row-wrap gap-3 beyond-stickers">
        {
          interests.map(({ label, accent, rot }) => (
            <span class={`sticker ${accent} ${rot}`}>{label}</span>
          ))
        }
      </div>
    </Card>
  </div>
</section>

<style>
  .beyond-stickers {
    margin-top: var(--space-6);
  }
</style>
