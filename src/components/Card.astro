---
import type { Accent } from "@/lib/types";

interface Props {
  as?: string;
  accent?: Accent;
  stripe?: boolean;
  pad?: boolean;
  press?: boolean;
  class?: string;
  id?: string;
  style?: string;
  [key: string]: unknown;
}

const {
  as: Tag = "div",
  accent,
  stripe = false,
  pad = true,
  press = false,
  class: className = "",
  id,
  style,
  ...rest
} = Astro.props;

const classes = [
  "card",
  accent && `card--${accent}`,
  stripe && "card--stripe",
  pad && "card-pad",
  press && "press",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<Tag class={classes} id={id} style={style} {...rest}><slot /></Tag>
