---
import { site } from "@/lib/site-config";

const social = site.social;
---

<section class="s-night" id="contact">
  <div class="wrap contact">
    <h2 class="contact-headline reveal">
      <span class="ln"><span>Let's</span></span>
      <span class="ln"><span>build.</span></span>
    </h2>
    <div class="row">
      <p>
        I'm always up for interesting work or a good chat, whether it's a job, a
        passion project or something a bit weird. If something here caught your
        eye, drop me a line.
      </p>
      <div>
        <div class="mail-row">
          <a class="mail" href={`mailto:${social.email}`}>{social.email}</a>
          <button
            class="copy"
            type="button"
            data-copy={social.email}
            aria-label="Copy email address"
            hidden>Copy</button
          >
          <span class="sr-only" aria-live="polite" data-copy-status></span>
        </div>
        <ul class="links" role="list">
          <li>
            <a href={social.linkedin} target="_blank" rel="noopener noreferrer"
              >LinkedIn <span class="arrow out" aria-hidden="true">↗</span></a
            >
          </li>
          <li>
            <a href={social.github} target="_blank" rel="noopener noreferrer"
              >GitHub <span class="arrow out" aria-hidden="true">↗</span></a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: 88px 80px;
  }
  h2 {
    font-size: clamp(96px, 26vw, 400px);
    line-height: 0.8;
    color: var(--butter);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: end;
    margin-top: 56px;
  }
  p {
    max-width: 50ch;
    margin: 0;
    font-size: 19px;
  }
  .mail {
    display: inline-block;
    border-bottom: 4px solid var(--butter);
    font: 800 clamp(24px, 3.4vw, 46px) / 1 var(--font-display);
    letter-spacing: 0.008em;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--dur-fast);
  }
  .mail:hover,
  .mail:focus-visible {
    color: var(--butter);
  }
  .mail-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }
  /* Script shows this only where the clipboard can be written. */
  .copy {
    padding: 9px 12px 8px;
    border: 2px solid var(--white);
    background: none;
    color: var(--white);
    font: 500 13px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast),
      transform 0.1s;
  }
  .copy:hover,
  .copy:focus-visible,
  .copy.done {
    border-color: var(--butter);
    background: var(--butter);
    color: var(--ink);
  }
  .copy:active {
    transform: translate(2px, 2px);
  }
  .links {
    display: flex;
    gap: 24px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }
  .links a {
    text-decoration: none;
    transition: color var(--dur-fast);
  }
  .links a:hover {
    color: var(--butter);
  }
  @media (max-width: 960px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .contact {
      padding-block: 64px 56px;
    }
    p {
      font-size: 17.5px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .copy,
    .mail,
    .links a {
      transition: none;
    }
  }
</style>
