---
import { site } from "@/lib/site-config";

const social = site.social;

/* What to write about. Each one is a link that starts an email with the
   ask as its subject. */
const asks = [
  "A product, from idea to launch",
  "AI tooling for your team",
  "An app that needs to get faster",
];
---

<section class="s-night" id="contact">
  <div class="wrap contact">
    <h2 class="contact-headline reveal" data-hop>
      <span class="ln">
        <span>Let's</span>
      </span>
      <span class="ln">
        <span>build.</span>
      </span>
    </h2>
    <div class="row">
      <div class="asks">
        <p class="label asks-label">Write to me about</p>
        <ul role="list">
          {asks.map((ask) => (
            <li>
              <a
                href={`mailto:${social.email}?subject=${encodeURIComponent(ask)}`}
              >
                {ask}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <p>
        I'm always up for interesting work or a good chat. If something here
        caught your eye, drop me a line.
      </p>
      <div>
        <a class="mail" href={`mailto:${social.email}`}>
          {social.email}
        </a>
        <ul class="links" role="list">
          <li>
            <a href={social.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn{" "}
              <span class="arrow out" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
          <li>
            <a href={social.github} target="_blank" rel="noopener noreferrer">
              GitHub{" "}
              <span class="arrow out" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
          <li>
            <a href="/agencies">For agencies</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: 88px 80px;
  }
  h2 {
    font-size: clamp(96px, 26vw, 400px);
    line-height: 0.8;
    color: var(--butter);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: end;
    margin-top: 56px;
  }
  p {
    max-width: 50ch;
    margin: 0;
    font-size: 19px;
  }
  /* Prompts for what to write about, in display type with butter markers. */
  .asks {
    grid-column: 1 / -1;
  }
  .asks-label {
    margin-bottom: 14px;
    color: var(--butter);
  }
  .asks ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .asks li {
    display: flex;
    gap: 0.4em;
    font: 800 clamp(26px, 2.8vw, 40px) / 0.95 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.008em;
  }
  .asks li::before {
    content: "+";
    color: var(--butter);
  }
  /* Each ask is a link: under a mouse or keyboard focus a butter bar wipes
     in behind it like a marker pen, and the text turns ink. */
  .asks a {
    padding: 2px 6px;
    margin: -2px -6px;
    background: linear-gradient(var(--butter), var(--butter)) no-repeat 0 0 / 0%
      100%;
    text-decoration: none;
  }
  .asks a:focus-visible {
    background-size: 100% 100%;
    color: var(--ink);
  }
  @media (hover: hover) {
    .asks a:hover {
      background-size: 100% 100%;
      color: var(--ink);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .asks a {
      transition:
        background-size 0.35s cubic-bezier(0.6, 0, 0.2, 1),
        color 0s 0.12s;
    }
  }
  .mail {
    display: inline-block;
    border-bottom: 4px solid var(--butter);
    font: 800 clamp(24px, 3.4vw, 46px) / 1 var(--font-display);
    letter-spacing: 0.008em;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--dur-fast);
  }
  .mail:hover,
  .mail:focus-visible {
    color: var(--butter);
  }
  .links {
    display: flex;
    gap: 24px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }
  /* The link turns butter, and a butter underline draws in from the left. */
  .links a {
    position: relative;
    padding-bottom: 2px;
    background: linear-gradient(var(--butter), var(--butter)) no-repeat 0 100% /
      0% 2px;
    text-decoration: none;
    transition:
      color var(--dur-fast),
      background-size 0.3s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--butter);
    background-size: 100% 2px;
  }
  @media (max-width: 960px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
  /* Wide screens: the note and the email sit beside the headline, not under it. */
  @media (min-width: 961px) {
    .contact {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: clamp(40px, 5vw, 96px);
      align-items: end;
    }
    h2 {
      font-size: clamp(96px, 19vw, 300px);
    }
    /* The prompts sit at the top beside "Let's"; the note and the email
       stay at the foot beside "build." */
    .row {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto auto;
      align-self: stretch;
      gap: 32px;
      margin-top: 0;
      padding-bottom: 12px;
    }
    .asks {
      padding-top: 0.6em;
    }
  }
  @media (max-width: 560px) {
    .contact {
      padding-block: 64px 56px;
    }
    p {
      font-size: 17.5px;
    }
  }
  /* A finger needs a 44px target; the hit area grows past the text, not the
     text itself, so the layout stays as drawn. */
  @media (pointer: coarse) {
    .mail,
    .asks a {
      position: relative;
    }
    .mail::before,
    .asks a::before,
    .links a::before {
      content: "";
      position: absolute;
      inset: -9px -4px;
    }
    .links a::before {
      inset: -13px -10px;
    }
    /* A one-line ask is 29px tall: 8px above and below make it 45px. */
    .asks a::before {
      inset: -8px -4px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mail,
    .links a {
      transition: none;
    }
  }
</style>
