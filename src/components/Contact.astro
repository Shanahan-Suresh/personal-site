---
import GlassCard from './GlassCard.astro';
---

<section id="contact" class="section-lg">
  <div class="container">
    <GlassCard tier={3} glow={true} class="reveal" style="padding:clamp(2.5rem,6vw,4.5rem);text-align:center;">
      <h2 class="h2 mb-4">Say hi.</h2>
      <p class="lead" style="max-width:520px;margin:0 auto var(--space-6);">
        I'm always open to interesting work and projects — full-time, contract, or something weird and fun. If any of this resonated, drop me a line.
      </p>
      <div class="flex-row wrap center gap-3">
        <a href="mailto:hello@shanahansuresh.dev" class="btn btn-primary">Email me</a>
        <a href="https://www.linkedin.com/in/shanahan-suresh" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">LinkedIn</a>
        <a href="https://github.com/Shanahan-Suresh" target="_blank" rel="noopener noreferrer" class="btn btn-subtle">GitHub</a>
      </div>
    </GlassCard>
  </div>
</section>
