---
import { site } from "@/lib/site-config";
import { execSync } from "node:child_process";

const year = new Date().getFullYear();

/* Build identity, resolved once at build time (static output, never at runtime).
   Cloudflare Pages exposes the deployed commit; local builds fall back to git.
   Either way the footer links to the exact commit that produced this page. */
function resolveCommit(): string | null {
  const fromEnv = process.env.CF_PAGES_COMMIT_SHA;
  if (fromEnv) return fromEnv;
  try {
    return execSync("git rev-parse HEAD", {
      stdio: ["ignore", "pipe", "ignore"],
    })
      .toString()
      .trim();
  } catch {
    return null;
  }
}
const commit = resolveCommit();
const shortSha = commit ? commit.slice(0, 7) : null;
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p class="footer-text">&copy; {year} {site.name}</p>
    <ul class="footer-links" role="list">
      <li><a href="/colophon" class="footer-link">Colophon</a></li>
      <li>
        <a
          href={site.repo}
          class="footer-link"
          target="_blank"
          rel="noopener noreferrer"
          >Source <span class="arrow out" aria-hidden="true">↗</span></a
        >
      </li>
      {
        shortSha && (
          <li>
            <a
              href={`${site.repo}/commit/${commit}`}
              class="footer-link footer-build"
              target="_blank"
              rel="noopener noreferrer"
              title="Commit this page was built from"
            >
              build {shortSha}
            </a>
          </li>
        )
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--night);
    color: #c9c5bb;
    --focus: var(--white);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 24px;
    padding-block: 18px calc(18px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid #3a362f;
    font: 400 13px/1.4 var(--font-mono);
  }
  .footer-text {
    margin: 0;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-link {
    border-bottom: 1px solid transparent;
    text-decoration: none;
    transition: border-color var(--dur-fast);
  }
  .footer-link:hover {
    border-color: var(--butter);
  }
  .footer-build {
    color: #8f8a80;
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-link {
      transition: none;
    }
  }
</style>
