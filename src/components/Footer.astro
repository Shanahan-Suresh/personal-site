---
import { site } from "@/lib/site-config";
import { execSync } from "node:child_process";

const year = new Date().getFullYear();

/* Build identity, resolved once at build time (static output, never at runtime).
   Cloudflare Workers Builds exposes the deployed commit; local builds fall
   back to git. Either way the footer links to the exact commit that produced
   this page. */
function resolveCommit(): string | null {
  const fromEnv = process.env.WORKERS_CI_COMMIT_SHA;
  if (fromEnv) return fromEnv;
  try {
    return execSync("git rev-parse HEAD", {
      stdio: ["ignore", "pipe", "ignore"],
    })
      .toString()
      .trim();
  } catch {
    return null;
  }
}
const commit = resolveCommit();
const shortSha = commit ? commit.slice(0, 7) : null;

/* The commit's subject and date for the build card. A shallow clone that
   lacks the commit leaves the card out. */
function describeCommit(sha: string | null) {
  if (!sha) return null;
  try {
    const [subject, date] = execSync(`git log -1 --format=%s%n%cI ${sha}`, {
      stdio: ["ignore", "pipe", "ignore"],
    })
      .toString()
      .trim()
      .split("\n");
    if (!subject || !date) return null;
    const day = new Date(date).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    });
    return { subject, day };
  } catch {
    return null;
  }
}
const built = describeCommit(commit);
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p class="footer-text">&copy; {year} {site.name}</p>
    <ul class="footer-links" role="list">
      <li><a href="/colophon" class="footer-link">Colophon</a></li>
      <li>
        <a
          href={site.repo}
          class="footer-link"
          target="_blank"
          rel="noopener noreferrer"
          >Source <span class="arrow out" aria-hidden="true">↗</span></a
        >
      </li>
      {
        shortSha && (
          <li>
            <a
              href={`${site.repo}/commit/${commit}`}
              class="footer-link footer-build"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={
                built
                  ? `build ${shortSha}, the commit this page was built from: ${built.subject}`
                  : `build ${shortSha}, the commit this page was built from`
              }
            >
              build {shortSha}
              {built && (
                <span class="build-card" aria-hidden="true">
                  <b>{built.subject}</b>
                  {shortSha} · {built.day} · view on GitHub ↗
                </span>
              )}
            </a>
          </li>
        )
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--night);
    color: #c9c5bb;
    --focus: var(--white);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 24px;
    padding-block: 18px calc(18px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid #3a362f;
    font: 400 13px/1.4 var(--font-mono);
  }
  .footer-text {
    margin: 0;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* A butter underline draws in from the left on hover and focus. */
  .footer-link {
    padding-bottom: 1px;
    background: linear-gradient(var(--butter), var(--butter)) no-repeat 0 100% /
      0% 1px;
    text-decoration: none;
    transition: background-size 0.3s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .footer-link:hover,
  .footer-link:focus-visible {
    background-size: 100% 1px;
  }
  /* A finger needs a 44px target: the hit area grows past the small mono
     text, and the gap between links keeps the areas apart. */
  @media (pointer: coarse) {
    .footer-link {
      position: relative;
    }
    .footer-link::before {
      content: "";
      position: absolute;
      inset: -13px -9px;
    }
  }
  .footer-build {
    position: relative;
    color: #8f8a80;
  }
  /* The build card: the commit this page was built from, over the link. */
  .build-card {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    z-index: 5;
    width: min(320px, 80vw);
    padding: 14px 16px;
    border: var(--seam) solid var(--ink);
    background: var(--butter);
    color: var(--ink);
    box-shadow: var(--hard-5) var(--ink);
    font: 500 13px/1.45 var(--font-mono);
    white-space: normal;
    /* A merge subject carries a 40-character hash or a long branch path. */
    overflow-wrap: anywhere;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.15s,
      transform 0.2s var(--ease-out),
      visibility 0s 0.2s;
    pointer-events: none;
  }
  .build-card b {
    display: block;
    margin-bottom: 6px;
    font: 700 15px/1.3 var(--font-body);
  }
  .footer-build:hover .build-card,
  .footer-build:focus-visible .build-card {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.15s,
      transform 0.2s var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-link,
    .build-card {
      transition: none;
    }
    .build-card {
      transform: none;
    }
  }
</style>
