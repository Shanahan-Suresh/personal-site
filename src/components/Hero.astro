---
import StatusChip from './StatusChip.astro';
import Card from './Card.astro';
---

<section
  class="hero-section"
  aria-label="Introduction"
>
  <div class="container">
    <div class="hero-inner">

      <!-- Left column: all copy -->
      <div class="hero-copy">

        <div class="reveal" style="--d:0ms">
          <StatusChip>Open to interesting work &amp; projects</StatusChip>
        </div>

        <p class="eyebrow hero-eyebrow reveal" style="--d:60ms" aria-label="Name: Shanahan Suresh">
          SHANAHAN SURESH
        </p>

        <h1 class="display hero-headline reveal" style="--d:120ms">
          I build full-stack<br>
          products &amp;&nbsp;<span class="tx-2 underline-skew">AI tooling.</span>
        </h1>

        <p class="lead reveal" style="--d:220ms">
          I'm a software engineer and a Computer Science with AI graduate from the University of Nottingham. I like turning ideas into products people enjoy using, so I build across the full stack, and lately a lot of that is AI tooling. How something feels to use matters to me as much as how it's built.
        </p>

        <div class="row row-wrap gap-4 reveal" style="--d:320ms">
          <a href="#work" class="btn btn-primary">See what I build</a>
          <a href="#contact" class="btn btn-ghost">Say hi</a>
        </div>

      </div>

      <!-- Right column: sticker cluster + quick-facts card -->
      <div class="hero-aside" aria-hidden="true">

        <div class="sticker-cluster reveal" style="--d:200ms">
          <span class="sticker sticker-1 rot-r">✦ Full-stack</span>
          <span class="sticker sticker-2 rot-l">Next.js</span>
          <span class="sticker sticker-pop rot-r">Python</span>
          <span class="sticker rot-l">AI tooling</span>
          <span class="sticker sticker-ink rot-r">UK educated</span>
        </div>

        <Card accent="1" stripe pad class="hero-facts reveal" style="--d:300ms">
          <ul class="facts-list">
            <li><span class="eyebrow">Degree</span><span>BSc CS with AI · Univ. of Nottingham</span></li>
            <li><span class="eyebrow">Stack</span><span>Next.js · Django · FastAPI · GCP</span></li>
            <li><span class="eyebrow">Focus</span><span>Product thinking · shipped end to end</span></li>
          </ul>
        </Card>

      </div>

    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 88vh;
    display: flex;
    align-items: center;
    padding-block: clamp(4rem, 10vw, 8rem);
    border-bottom: var(--border-thick);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr clamp(260px, 30vw, 380px);
    gap: var(--space-9);
    align-items: start;
  }

  .hero-eyebrow {
    margin-top: var(--space-5);
    margin-bottom: var(--space-4);
  }

  .hero-headline {
    margin-bottom: var(--space-6);
    max-width: 14ch;
  }

  .hero-copy .lead {
    margin-bottom: var(--space-6);
  }

  /* right column */
  .hero-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: clamp(3rem, 6vw, 6rem); /* roughly align mid-headline */
  }

  .sticker-cluster {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  /* facts list inside Card */
  .facts-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .facts-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .facts-list li > span:last-child {
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  @media (max-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
    .hero-aside {
      padding-top: 0;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
    }
    .sticker-cluster {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .hero-facts {
      flex: 1 1 260px;
    }
  }
</style>
