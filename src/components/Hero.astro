---
import MediaFrame from "./MediaFrame.astro";
import portrait from "@/assets/scrapbook/portrait-cutout-v4.png";
import { projects } from "@/data/projects";

const rsvp = projects.find((p) => p.id === "rsvp")!;
---

<section class="slab s-tomato hero" aria-label="Introduction">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <h1 class="hero-headline reveal">
        <span class="ln"
          ><span class="l"
            >I build <br class="m" /><span class="keep">full-stack</span></span
          ></span
        >
        <span class="ln"><span class="l">products &amp;</span></span>
        <span class="ln"
          ><span class="l"><span class="mk">AI tooling.</span></span></span
        >
      </h1>
      <div class="hero-card">
        <p>
          I'm a software engineer and a Computer Science with AI graduate from
          the University of Nottingham. I turn ideas into products people enjoy
          using, with as much care for how they feel as how they're built.
        </p>
        <div class="ctas">
          <a href="#work" class="btn">See what I build</a>
          <a href="#contact" class="btn btn-alt">Say hi</a>
        </div>
      </div>
    </div>

    <div class="shots reveal">
      <MediaFrame
        image={portrait}
        alt="Shanahan Suresh smiling in a navy jacket and white shirt."
        fit="cover"
        objectPosition="50% 18%"
        aspectRatio="4 / 5"
        widths={[360, 520, 720]}
        sizes="(max-width: 560px) 84vw, (max-width: 960px) 50vw, 440px"
        priority
        class="face rise"
      />
      {
        rsvp.media && (
          <MediaFrame
            image={rsvp.media.image}
            alt={rsvp.media.alt}
            caption={`RSVP app · ${rsvp.fact.value} guests`}
            fit="cover"
            objectPosition="top"
            aspectRatio="16 / 11"
            widths={[280, 420, 560]}
            sizes="(max-width: 560px) 54vw, (max-width: 960px) 30vw, 280px"
            loading="eager"
            class="f2 rise rise-late"
          />
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
    padding-block: 56px 72px;
  }
  /* The headline scales with its column, so its three lines always fit. */
  .hero-copy {
    container-type: inline-size;
  }
  .hero-headline {
    font-size: calc(100cqi / 6.5);
    line-height: 0.9;
  }
  .hero-headline .l {
    white-space: nowrap;
  }
  .hero-headline .m {
    display: none;
  }
  .mk {
    margin-left: -0.04em;
    padding: 0 0.12em 0.02em;
    background: var(--butter);
    border: var(--seam) solid var(--ink);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .hero-card {
    max-width: 760px;
    margin-top: 40px;
    padding: 26px 28px;
    background: var(--card);
    color: var(--text);
    border: var(--seam) solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    --focus: var(--edge);
  }
  .hero-card p {
    max-width: 56ch;
    margin: 0 0 22px;
    font-size: 19px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .shots {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 520px;
    padding-bottom: 56px;
  }
  .shots :global(.face) {
    width: 84%;
  }
  .shots :global(.face .media-canvas) {
    background: var(--butter);
  }
  .shots :global(.f2) {
    position: absolute;
    right: -14px;
    bottom: 0;
    width: 54%;
    box-shadow: 5px 5px 0 var(--ink);
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    /* The left offset comes out of the width, so the stack never overflows. */
    .shots {
      justify-self: start;
      width: 86%;
      max-width: 560px;
      margin-left: 14%;
    }
  }
  @media (max-width: 560px) {
    .hero-inner {
      padding-block: 40px 56px;
    }
    .hero-headline {
      font-size: calc(100cqi / 4.75);
    }
    .hero-headline .m {
      display: block;
    }
    .hero-headline .l {
      white-space: normal;
    }
    .hero-card {
      margin-top: 32px;
      padding: 20px;
      box-shadow: 6px 6px 0 var(--ink);
    }
    .hero-card p {
      font-size: 17.5px;
    }
    .shots {
      width: 100%;
      margin-left: 0;
      padding-bottom: 44px;
    }
    .shots :global(.f2) {
      right: 0;
    }
  }
</style>
