---
import Card from "./Card.astro";
---

<section class="hero-section" aria-label="Introduction">
  <div class="container">
    <div class="hero-inner">
      <!-- Left column: all copy -->
      <div class="hero-copy">
        <p
          class="eyebrow hero-eyebrow hero-rise"
          style="--d:60ms"
          aria-label="Name: Shanahan Suresh"
        >
          SHANAHAN SURESH
        </p>

        <h1 class="display hero-headline">
          <span class="slam-line" style="--d:120ms"
            ><span>I build full-stack</span></span
          >
          <span class="slam-line" style="--d:200ms"
            ><span
              >products &amp;&nbsp;<span class="tx-2 underline-skew marker"
                >AI tooling.</span
              ></span
            ></span
          >
        </h1>

        <p class="lead hero-rise" style="--d:280ms">
          I'm a software engineer and a Computer Science with AI graduate from
          the University of Nottingham. I like turning ideas into products
          people enjoy using, so I build across the full stack, and lately a lot
          of that is agentic coding. How something feels to use matters to me as
          much as how it's built.
        </p>

        <div class="row row-wrap gap-4 hero-rise" style="--d:360ms">
          <a href="#work" class="btn btn-primary" data-magnetic>See what I build</a>
          <a href="#contact" class="btn btn-ghost">Say hi</a>
        </div>
      </div>

      <!-- Right column: sticker cluster + quick-facts card -->
      <div class="hero-aside" aria-hidden="true">
        <div class="sticker-cluster">
          <span class="sticker sticker-1 rot-r" style="--i:0">✦ Full-stack</span>
          <span class="sticker sticker-2 rot-l" style="--i:1">Next.js</span>
          <span class="sticker sticker-4 rot-r" style="--i:2">Python</span>
          <span class="sticker rot-l" style="--i:3">MCP servers</span>
          <span class="sticker sticker-ink rot-r" style="--i:4">UK Graduate</span>
        </div>

        <!-- enters on the beat after the last sticker — derived from the
             shared stamp cadence in global.css, so it never drifts -->
        <div
          class="hero-facts-wrap hero-rise"
          style="--d: calc(var(--stamp-from) + var(--stamp-count) * var(--stamp-step))"
        >
          <Card accent="1" stripe pad press data-tilt class="hero-facts">
          <ul class="facts-list">
            <li>
              <span class="eyebrow">Degree</span><span
                >BSc (Hons) CS with AI · Univ. of Nottingham</span
              >
            </li>
            <li>
              <span class="eyebrow">Main Stack</span><span
                >Next.js · Django · GCP</span
              >
            </li>
            <li>
              <span class="eyebrow">Focus</span><span
                >Product thinking · shipped end to end</span
              >
            </li>
          </ul>
          </Card>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    display: flex;
    align-items: center;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3.5rem, 9vw, 7rem);
    /* no bottom rule: the marquee below frames itself with its own
       border, so a rule here would stack into a double line */
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr clamp(260px, 30vw, 380px);
    gap: var(--space-9);
    align-items: start;
  }

  .hero-eyebrow {
    margin-top: var(--space-5);
    margin-bottom: var(--space-4);
  }

  .hero-headline {
    margin-bottom: var(--space-6);
    max-width: 14ch;
  }

  .hero-copy .lead {
    margin-bottom: var(--space-6);
  }

  /* right column */
  .hero-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: clamp(3rem, 6vw, 6rem); /* roughly align mid-headline */
  }

  .sticker-cluster {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  /* facts list inside Card */
  .facts-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .facts-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .facts-list li > span:last-child {
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  /* Match the damped tilt of the other content cards exactly. The .reveal cards
     transition ONLY transform over --dur-slow; the hard offset shadow is left out
     of the shorthand so it snaps instantly on hover. This card isn't a .reveal, so
     without this rule it falls back to .press's snappy --dur-fast (twitchy). Just
     as important: transform ONLY — animating box-shadow over 0.6s makes the sharp
     shadow crawl under the 3D tilt, which reads as jagged edges. Snap it like the rest. */
  .hero-facts {
    transition: transform var(--dur-slow) var(--ease-out);
  }

  @media (max-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
    .hero-aside {
      padding-top: 0;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
    }
    .sticker-cluster {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .hero-facts-wrap {
      flex: 1 1 260px;
    }
  }
</style>
