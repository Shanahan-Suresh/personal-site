---
import MediaFrame from "./MediaFrame.astro";
import portrait from "@/assets/scrapbook/portrait-cutout-v4.png";
/* The RSVP frame has its own 16:11 render, so both cards sit whole in it. */
import rsvpHero from "@/assets/work/rsvp-glass-hero.png";
import { projects } from "@/data/projects";

const rsvp = projects.find((p) => p.id === "rsvp")!;
---

<section class="slab s-sky hero" aria-label="Introduction">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <h1 class="hero-headline reveal">
        <span class="ln">
          <span class="l">
            I build <br class="m" />
            <span class="keep">full-stack</span>
          </span>
        </span>
        <span class="ln">
          <span class="l">products &amp;</span>
        </span>
        <span class="ln">
          <span class="l">
            <span class="mk" data-brush data-flip>
              <span class="mk-shadow"></span>
              <span class="mk-card">
                <span class="mk-face">AI tooling.</span>
                <span
                  class="mk-face mk-back"
                  data-text="AI tooling."
                  aria-hidden="true"
                ></span>
              </span>
            </span>
          </span>
        </span>
      </h1>
      <div class="hero-card">
        <p>
          I've spent three years as a software engineer, building products for
          companies and for myself. My degree is in Computer Science with AI,
          from the University of Nottingham. Hand me an idea, and I'll ship a
          product people enjoy using.
        </p>
        <div class="ctas">
          <a href="#work" class="btn">
            See what I build
          </a>
          <a href="#contact" class="btn btn-alt">
            Say hi
          </a>
        </div>
      </div>
    </div>

    <div class="shots reveal">
      <MediaFrame
        image={portrait}
        alt="Shanahan Suresh smiling in a navy jacket and white shirt."
        fit="cover"
        objectPosition="50% 18%"
        aspectRatio="4 / 5"
        widths={[360, 520, 720, 960]}
        sizes="(max-width: 560px) 84vw, (max-width: 960px) min(66vw, 470px), 440px"
        priority
        class="face rise"
      >
        <span slot="overlay" class="plate" aria-hidden="true">
          Hi, I'm Shanahan 👋
        </span>
      </MediaFrame>
      {rsvp.media && (
        <a
          class="f2"
          href={`#story-${rsvp.id}`}
          data-story={rsvp.id}
          aria-haspopup="dialog"
        >
          <MediaFrame
            image={rsvpHero}
            alt={rsvp.media.alt}
            fit="cover"
            objectPosition="top"
            aspectRatio="16 / 11"
            widths={[280, 420, 560, 640]}
            sizes="(max-width: 560px) 54vw, (max-width: 960px) min(42vw, 304px), 280px"
            loading="eager"
            class="rise rise-late"
          >
            <Fragment slot="caption">
              RSVP app · {rsvp.fact.value} guests{" "}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </Fragment>
          </MediaFrame>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
    padding-block: 56px 72px;
  }
  /* The headline scales with its column, so its three lines always fit. */
  .hero-copy {
    container-type: inline-size;
  }
  .hero-headline {
    font-size: calc(100cqi / 6.5);
    line-height: 0.9;
  }
  .hero-headline .l {
    white-space: nowrap;
  }
  .hero-headline .m {
    display: none;
  }
  /* A tilted label stuck on the last line. Its line gets extra room, so the
     reveal mask still clips the rise but never the label's frame or shadow. */
  .hero-headline .ln:has(.mk) {
    padding: 0.14em 0.2em 0.22em;
    margin: -0.14em -0.2em -0.22em;
  }
  /* The label is a double-sided sign: a card with a front and a back face,
     and a flat shadow under it. The shadow is its own block, not a
     box-shadow: a real border and box-shadow leave a hairline gap where they
     meet on a tilted box, because the browser cuts the shadow at the
     border's outer edge. This block runs under the border instead. */
  .mk {
    position: relative;
    isolation: isolate; /* keeps the plate above the slab when hover drops the tilt */
    display: inline-block;
    transform: rotate(-1.6deg);
  }
  .mk-card {
    display: block;
    transform: var(--flip, none);
    transform-style: preserve-3d;
  }
  .mk-face {
    display: block;
    padding: 0.02em 0.12em 0.04em;
    background: var(--butter) padding-box;
    border: var(--seam) solid var(--ink);
    backface-visibility: hidden;
  }
  /* The back is printed like a real sign's: after a half turn it reads
     upside down, until the next half turn rights it. Its text comes from
     CSS, so the headline's text holds the words once. */
  .mk-back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
  }
  .mk-back::before {
    content: attr(data-text);
  }
  /* A hole under the plate keeps the shadow out of the unfilled part during
     the hover fill. Its edges sit mid-border, so the cut never shows. While
     the label turns, the shadow takes the same 3D turn (--flip), so its
     outline is the card's own, offset. Past a quarter turn it mirrors back
     (--flip-m), so the cut stays under the card and not above it.
     At rest the shadow hides under the card (--shadow-off 0). While the label is
     turned (`.turned`, set by script) it drops to the 5px hard shadow at
     once; when the label lands right way up it slides back under in 0.5s.
     --shadow-off is a registered length, so it eases and the cut moves with it.
     --flip-s is --flip for the shadow, never `none`: `none` inside a
     transform list makes the whole transform invalid. */
  .mk-shadow {
    --shadow-off: 0px;
    --h: calc(var(--seam) / 2);
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    transform: translate(var(--shadow-off), var(--shadow-off))
      var(--flip-s, rotateX(0deg)) scaleY(var(--flip-m, 1));
    transition: --shadow-off 0.5s ease-in-out;
    clip-path: polygon(
      evenodd,
      0 0,
      100% 0,
      100% 100%,
      0 100%,
      0 0,
      calc(var(--h) - var(--shadow-off)) calc(var(--h) - var(--shadow-off)),
      calc(var(--h) - var(--shadow-off))
        calc(100% - var(--shadow-off) - var(--h)),
      calc(100% - var(--shadow-off) - var(--h))
        calc(100% - var(--shadow-off) - var(--h)),
      calc(100% - var(--shadow-off) - var(--h))
        calc(var(--h) - var(--shadow-off)),
      calc(var(--h) - var(--shadow-off)) calc(var(--h) - var(--shadow-off))
    );
  }
  .turned .mk-shadow {
    --shadow-off: 5px; /* --hard-5 */
    transition: none;
  }
  @property --shadow-off {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }
  .hero-card {
    max-width: 760px;
    margin-top: 40px;
    padding: 26px 28px;
    background: var(--card);
    color: var(--text);
    border: var(--seam) solid var(--ink);
    box-shadow: var(--hard-8) var(--ink);
    --focus: var(--edge);
  }
  .hero-card p {
    max-width: 56ch;
    margin: 0 0 22px;
    font-size: 19px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .shots {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 520px;
    padding-bottom: 56px;
  }
  .shots :global(.face) {
    width: 84%;
  }
  .shots :global(.face .media-canvas) {
    position: relative;
    background: var(--cream);
  }
  /* A name plate drops in over the top of the portrait under a mouse. It is
     clipped, not moved, so it never leaves the frame. White, because the
     yellow wave emoji vanishes on butter and ink reads too heavy. */
  .plate {
    position: absolute;
    inset: 0 0 auto;
    padding: 9px 12px;
    border-bottom: var(--seam) solid var(--ink);
    background: var(--white);
    color: var(--ink);
    font: 500 13px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    clip-path: inset(0 0 100% 0);
  }
  @media (hover: hover) {
    .shots :global(.face:hover) .plate {
      clip-path: inset(0);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .plate {
      transition: clip-path 0.3s var(--ease-out);
    }
  }
  /* Under a mouse the label's butter plate fills from its left edge to the
     pointer, like a loading bar. When the pointer leaves, the plate fills in
     again. Script sets the fill's width (--brush, in px from the inner left
     edge). The fill stays inside the border: a fill under it shows through
     as specks along the tilted edge. The back face is turned round, so its
     fill starts from its own right edge, which faces the screen's left. A
     still box over the label keeps the pointer while the card turns away. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .mk {
      transition: transform 0.3s var(--ease-out);
    }
    .mk::after {
      content: "";
      position: absolute;
      inset: -6px;
      z-index: 1;
    }
    .mk-face {
      background: linear-gradient(var(--butter), var(--butter)) no-repeat
        padding-box 0 0 / 100% 100%;
      transition: background-size 0.35s var(--ease-out);
    }
    .mk-back {
      background-position: 100% 0;
    }
    .mk:hover {
      transform: none;
    }
    .mk.brushing .mk-face {
      background-size: var(--brush) 100%;
      transition-duration: 0.18s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mk-back {
      display: none;
    }
  }
  /* The RSVP frame is a link to its story: it lifts into a deeper shadow.
     It leans 2deg clockwise, against the headline label's lean. `rotate` is
     its own property, so the hover lift (`transform`) adds to it. */
  .f2 {
    position: absolute;
    right: -14px;
    bottom: 0;
    width: 54%;
    rotate: 2deg;
    text-decoration: none;
    transition: transform 0.12s var(--ease-out);
  }
  .f2 :global(.frame) {
    box-shadow: var(--hard-5) var(--ink);
  }
  .f2:hover,
  .f2:focus-visible {
    transform: translate(-3px, -3px);
  }
  .f2:hover :global(.frame),
  .f2:focus-visible :global(.frame) {
    box-shadow: var(--hard-8) var(--ink);
  }
  .f2:focus-visible {
    outline-offset: 6px;
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    /* The left offset comes out of the width, so the stack never overflows. */
    .shots {
      justify-self: start;
      width: 86%;
      max-width: 560px;
      margin-left: 14%;
    }
  }
  @media (max-width: 560px) {
    .hero-inner {
      padding-block: 40px 56px;
    }
    .hero-headline {
      font-size: calc(100cqi / 4.75);
    }
    .hero-headline .m {
      display: block;
    }
    .hero-headline .l {
      white-space: normal;
    }
    .hero-card {
      margin-top: 32px;
      padding: 20px;
      box-shadow: var(--hard-6) var(--ink);
    }
    .hero-card p {
      font-size: 17.5px;
    }
    .shots {
      width: 100%;
      margin-left: 0;
      padding-bottom: 44px;
    }
    .f2 {
      right: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .f2 {
      transition: none;
    }
  }
</style>
