---
import MediaFrame from "./MediaFrame.astro";
import portrait from "@/assets/scrapbook/portrait-cutout-v4.png";
import { projects } from "@/data/projects";

const rsvp = projects.find((p) => p.id === "rsvp")!;
---

<section class="slab s-sky hero" aria-label="Introduction">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <h1 class="hero-headline reveal">
        <span class="ln"
          ><span class="l"
            >I build <br class="m" /><span class="keep">full-stack</span></span
          ></span
        >
        <span class="ln"><span class="l">products &amp;</span></span>
        <span class="ln"
          ><span class="l"><span class="mk" data-brush>AI tooling.</span></span
          ></span
        >
      </h1>
      <div class="hero-card">
        <p>
          I'm a software engineer and a Computer Science with AI graduate from
          the University of Nottingham. I like to own a product from the first
          idea to the last detail of how it feels to use.
        </p>
        <div class="ctas">
          <a href="#work" class="btn">See what I build</a>
          <a href="#contact" class="btn btn-alt">Say hi</a>
        </div>
      </div>
    </div>

    <div class="shots reveal">
      <MediaFrame
        image={portrait}
        alt="Shanahan Suresh smiling in a navy jacket and white shirt."
        fit="cover"
        objectPosition="50% 18%"
        aspectRatio="4 / 5"
        widths={[360, 520, 720, 960]}
        sizes="(max-width: 560px) 84vw, (max-width: 960px) min(66vw, 470px), 440px"
        priority
        class="face rise"
      >
        <span slot="overlay" class="plate" aria-hidden="true"
          >Hi, I'm Shanahan 👋</span
        >
      </MediaFrame>
      {
        rsvp.media && (
          <a
            class="f2"
            href={`#story-${rsvp.id}`}
            data-story={rsvp.id}
            aria-haspopup="dialog"
          >
            <MediaFrame
              image={rsvp.media.image}
              alt={rsvp.media.alt}
              fit="cover"
              objectPosition="top"
              aspectRatio="16 / 11"
              widths={[280, 420, 560, 640]}
              sizes="(max-width: 560px) 54vw, (max-width: 960px) min(42vw, 304px), 280px"
              loading="eager"
              class="rise rise-late"
            >
              <Fragment slot="caption">
                RSVP app · {rsvp.fact.value} guests{" "}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </Fragment>
            </MediaFrame>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
    padding-block: 56px 72px;
  }
  /* The headline scales with its column, so its three lines always fit. */
  .hero-copy {
    container-type: inline-size;
  }
  .hero-headline {
    font-size: calc(100cqi / 6.5);
    line-height: 0.9;
  }
  .hero-headline .l {
    white-space: nowrap;
  }
  .hero-headline .m {
    display: none;
  }
  /* A tilted label stuck on the last line. Its line gets extra room, so the
     reveal mask still clips the rise but never the label's frame or shadow. */
  .hero-headline .ln:has(.mk) {
    padding: 0.14em 0.2em 0.22em;
    margin: -0.14em -0.2em -0.22em;
  }
  .mk {
    display: inline-block;
    padding: 0.02em 0.12em 0.04em;
    background: var(--butter);
    border: var(--seam) solid var(--ink);
    box-shadow: var(--hard-5) var(--ink);
    transform: rotate(-1.6deg);
  }
  .hero-card {
    max-width: 760px;
    margin-top: 40px;
    padding: 26px 28px;
    background: var(--card);
    color: var(--text);
    border: var(--seam) solid var(--ink);
    box-shadow: var(--hard-8) var(--ink);
    --focus: var(--edge);
  }
  .hero-card p {
    max-width: 56ch;
    margin: 0 0 22px;
    font-size: 19px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .shots {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 520px;
    padding-bottom: 56px;
  }
  .shots :global(.face) {
    width: 84%;
  }
  .shots :global(.face .media-canvas) {
    position: relative;
    background: var(--cream);
  }
  /* A name plate drops in over the top of the portrait under a mouse. It is
     clipped, not moved, so it never leaves the frame. */
  .plate {
    position: absolute;
    inset: 0 0 auto;
    padding: 9px 12px;
    border-bottom: var(--seam) solid var(--ink);
    background: var(--ink);
    color: var(--butter);
    font: 500 13px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    clip-path: inset(0 0 100% 0);
  }
  @media (hover: hover) {
    .shots :global(.face:hover) .plate {
      clip-path: inset(0);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .plate {
      transition: clip-path 0.3s var(--ease-out);
    }
  }
  /* Under a mouse the label's butter plate shrinks to a band under the
     pointer and grows wherever the pointer moves, like a highlighter. When
     the pointer leaves, the plate fills in again. Script sets the band's
     edges (--brush-a, --brush-b, in px from the label's left edge). */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .mk {
      background: linear-gradient(var(--butter), var(--butter)) no-repeat
        border-box 0 0 / 100% 100%;
      transition:
        background-size 0.35s var(--ease-out),
        background-position 0.35s var(--ease-out),
        transform 0.3s var(--ease-out);
    }
    .mk:hover {
      transform: none;
    }
    .mk.brushing {
      background-position: var(--brush-a) 0;
      background-size: calc(var(--brush-b) - var(--brush-a)) 100%;
      transition-duration: 0.18s, 0.18s, 0.3s;
    }
  }
  /* The RSVP frame is a link to its story: it lifts into a deeper shadow. */
  .f2 {
    position: absolute;
    right: -14px;
    bottom: 0;
    width: 54%;
    text-decoration: none;
    transition: transform 0.12s var(--ease-out);
  }
  .f2 :global(.frame) {
    box-shadow: var(--hard-5) var(--ink);
  }
  .f2:hover,
  .f2:focus-visible {
    transform: translate(-3px, -3px);
  }
  .f2:hover :global(.frame),
  .f2:focus-visible :global(.frame) {
    box-shadow: var(--hard-8) var(--ink);
  }
  .f2:hover :global(figcaption),
  .f2:focus-visible :global(figcaption) {
    background: var(--butter);
    color: var(--ink);
  }
  .f2:focus-visible {
    outline-offset: 6px;
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    /* The left offset comes out of the width, so the stack never overflows. */
    .shots {
      justify-self: start;
      width: 86%;
      max-width: 560px;
      margin-left: 14%;
    }
  }
  @media (max-width: 560px) {
    .hero-inner {
      padding-block: 40px 56px;
    }
    .hero-headline {
      font-size: calc(100cqi / 4.75);
    }
    .hero-headline .m {
      display: block;
    }
    .hero-headline .l {
      white-space: normal;
    }
    .hero-card {
      margin-top: 32px;
      padding: 20px;
      box-shadow: var(--hard-6) var(--ink);
    }
    .hero-card p {
      font-size: 17.5px;
    }
    .shots {
      width: 100%;
      margin-left: 0;
      padding-bottom: 44px;
    }
    .f2 {
      right: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .f2 {
      transition: none;
    }
  }
</style>
