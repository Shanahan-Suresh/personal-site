---
import { Image } from "astro:assets";
import copperCoil from "@/assets/scrapbook/free-use-v5/copper-coil-hero-v5.jpg";
---

<section class="hero-section" aria-label="Introduction">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-title">
        <p
          class="eyebrow hero-eyebrow hero-rise"
          style="--d:60ms"
          aria-label="Name: Shanahan Suresh"
        >
          SHANAHAN SURESH
        </p>

        <h1 class="display hero-headline">
          <span class="slam-line" style="--d:120ms"
            ><span>I build <span class="keep-together">full-stack</span></span
            ></span
          >
          <span class="slam-line" style="--d:200ms"
            ><span
              >products &amp;&nbsp;<span class="tx-2 underline-skew marker"
                >AI tooling.</span
              ></span
            ></span
          >
        </h1>
      </div>

      <div class="hero-aside hero-rise" style="--d:320ms">
        <figure class="workbench-frame">
          <Image
            src={copperCoil}
            alt="A tightly wound copper coil surrounded by blue components on a yellow circuit board."
            format="webp"
            quality={80}
            widths={[360, 560, 800]}
            sizes="(max-width: 820px) 88vw, 40vw"
            loading="eager"
            fetchpriority="high"
            class="workbench-image"
          />
          <figcaption>
            Built one detail at a time.
            <a
              class="hero-credit"
              href="https://unsplash.com/photos/a-close-up-of-a-circuit-board-with-many-electronic-components-8hcIIZ8SoyU"
              >Photo by Ludovico Ceroseis / Unsplash.</a
            >
          </figcaption>
        </figure>

        <div class="sticker-cluster hero-stickers">
          <span class="sticker sticker-1 rot-l" style="--i:0">Full-stack</span>
          <span class="sticker sticker-ink rot-r" style="--i:1"
            >UK graduate</span
          >
        </div>
      </div>

      <div class="hero-copy">
        <p class="lead hero-rise" style="--d:280ms">
          I'm a software engineer and a Computer Science with AI graduate from
          the University of Nottingham. I turn ideas into products people enjoy
          using, with as much care for how they feel as how they're built.
        </p>

        <div class="row row-wrap gap-4 hero-rise" style="--d:360ms">
          <a href="#work" class="btn btn-primary" data-magnetic
            >See what I build</a
          >
          <a href="#contact" class="btn btn-ghost">Say hi</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    display: flex;
    align-items: center;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3.5rem, 8vw, 6rem);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 4rem);
    row-gap: var(--space-5);
    align-items: start;
  }

  .hero-title {
    grid-column: 1;
  }

  .hero-eyebrow {
    margin-bottom: var(--space-4);
  }

  .hero-headline {
    font-size: clamp(3.2rem, 6.7vw, 6.5rem);
    max-width: 14ch;
  }

  .keep-together {
    white-space: nowrap;
  }

  .hero-copy {
    grid-column: 1;
  }

  .hero-copy .lead {
    margin-bottom: var(--space-5);
    max-width: 44ch;
  }

  .hero-aside {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    margin: clamp(4rem, 7vw, 6.5rem) var(--space-2) var(--space-6) 0;
  }

  .workbench-frame {
    margin: 0;
    border: var(--border-thick);
    box-shadow: var(--shadow-hard-lg);
    background: var(--surface);
    transform: rotate(2deg);
  }

  .workbench-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }

  figcaption {
    padding: var(--space-3) var(--space-4);
    border-top: var(--border);
    font-size: var(--fs-sm);
    line-height: 1.4;
  }
  .hero-credit {
    display: block;
    margin-top: 0.4rem;
    color: var(--ink-soft);
    font-size: 0.75rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .hero-stickers {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    position: absolute;
    left: calc(-1 * var(--space-3));
    right: calc(-1 * var(--space-2));
    bottom: calc(-1 * var(--space-5));
  }

  @media (max-width: 820px) {
    .hero-section {
      padding-top: var(--space-6);
    }

    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-5);
    }

    .hero-headline {
      font-size: clamp(3rem, 10.8vw, 5.5rem);
      max-width: 17ch;
    }

    .hero-aside {
      grid-column: 1;
      grid-row: auto;
      margin: var(--space-5) var(--space-2) var(--space-5);
    }

    .workbench-image {
      height: clamp(160px, 40vw, 240px);
      aspect-ratio: 16 / 9;
      object-position: 50% 25%;
    }

    .hero-stickers .sticker {
      font-size: 0.68rem;
    }

    figcaption {
      font-size: 0.8rem;
      padding: var(--space-2) var(--space-3);
    }
  }
</style>
