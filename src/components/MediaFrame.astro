---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  fit?: "cover" | "contain";
  objectPosition?: string;
  credit?: { label: string; href: string };
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  /** Fetch first: only for the one image that leads the page. */
  priority?: boolean;
  /** Defaults to the image's own proportions. */
  aspectRatio?: string;
  class?: string;
  style?: string;
}

const {
  image,
  alt,
  caption,
  fit = "contain",
  objectPosition = "center",
  credit,
  widths = [480, 720, 1040],
  sizes = "(max-width: 960px) 90vw, 520px",
  loading = "lazy",
  priority = false,
  aspectRatio = `${image.width} / ${image.height}`,
  class: className = "",
  style = "",
} = Astro.props;
---

<figure
  class={`frame media-frame ${className}`}
  style={`--media-ratio:${aspectRatio};--media-fit:${fit};--media-position:${objectPosition};${style}`}
>
  <div class="media-canvas">
    <Image
      src={image}
      alt={alt}
      format="webp"
      quality={80}
      widths={widths}
      sizes={sizes}
      loading={priority ? "eager" : loading}
      fetchpriority={priority ? "high" : undefined}
      decoding="async"
    />
  </div>
  {
    (caption || credit || Astro.slots.has("caption")) && (
      <figcaption>
        <slot name="caption">{caption}</slot>
        {credit && (
          <span class="media-credit">
            <a href={credit.href}>{credit.label}</a>
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .media-frame {
    min-width: 0;
  }
  .media-canvas {
    aspect-ratio: var(--media-ratio);
    overflow: hidden;
    background: var(--white);
  }
  .media-canvas img {
    width: 100%;
    height: 100%;
    object-fit: var(--media-fit);
    object-position: var(--media-position);
  }
  .media-credit {
    display: block;
    margin-top: 4px;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: none;
  }
  .media-credit a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
