---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="nav-wrapper">
  <nav class="glass nav-inner">
    <a href="/" class="brand">Shanahan Suresh</a>
    <div class="nav-links">
      <a href="/#work" class="text-sm">Work</a>
      <a href="/writing" class="text-sm">Writing</a>
      <a href="/#contact" class="text-sm">Contact</a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .nav-wrapper {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 1rem 1.5rem;
  }

  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
  }

  .brand {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: -0.03em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--text-body);
    text-decoration: none;
    transition: color var(--dur-fast);
  }

  .nav-links a:hover {
    color: var(--accent);
  }
</style>
