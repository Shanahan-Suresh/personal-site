---
import ThemeToggle from "./ThemeToggle.astro";
import { navLinks } from "@/data/navigation";

/* Anton's S outline, as on main's monogram (font units, flipped upright). */
const S_PATH =
  "M496 -16Q255 -16 148.5 104.0Q42 224 42 486V658H390V438Q390 377 408.5 342.5Q427 308 473 308Q521 308 539.5 336.0Q558 364 558 428Q558 509 542.0 563.5Q526 618 486.5 667.5Q447 717 377 783L219 933Q42 1100 42 1315Q42 1540 146.5 1658.0Q251 1776 449 1776Q691 1776 792.5 1647.0Q894 1518 894 1255H536V1376Q536 1412 515.5 1432.0Q495 1452 460 1452Q418 1452 398.5 1428.5Q379 1405 379 1368Q379 1331 399.0 1288.0Q419 1245 478 1189L681 994Q742 936 793.0 871.5Q844 807 875.0 721.5Q906 636 906 513Q906 265 814.5 124.5Q723 -16 496 -16Z";
---

<header class="nav-header">
  <nav class="wrap nav-inner" aria-label="Main">
    <a href="/" class="nav-name" aria-label="Shanahan Suresh, home">
      <span class="nn-mark" aria-hidden="true">
        {["top", "bot"].map((half) => (
          <svg
            class={`nn-s ${half}`}
            viewBox="30 -1790 888 1820"
            focusable="false"
          >
            <path transform="scale(1,-1)" fill="currentColor" d={S_PATH} />
          </svg>
        ))}
      </span>
      <span class="nn-lines" aria-hidden="true">
        <span>hanahan</span>
        <span>uresh</span>
      </span>
    </a>
    <button
      class="nav-burger"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul class="nav-links" role="list" id="mobile-nav">
      {navLinks.map((l) => (
        <li>
          <a href={l.href} class="nav-link">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    background: var(--night);
    color: var(--white);
    border-bottom: var(--seam) solid var(--ink);
    --focus: var(--white);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--nav-h);
  }
  /* The name: one tall butter S (Anton's outline) with a hard cobalt shadow,
     shared by HANAHAN over URESH. Two copies of the S sit on top of each
     other, so at rest they read as one. Hover and focus split them: the top
     copy shrinks toward its top-left corner, in front of HANAHAN, the bottom
     copy toward its bottom-left corner, in front of URESH, and the lines slide
     left, so the bar reads SHANAHAN over SURESH. --k is the small S height over
     the tall one: the small S stands about 2px taller than the caps, an initial
     capital. The two transform origins set each small S on its own line's
     baseline, and --slide leaves the same gap after the S as between letters. */
  .nav-name {
    --k: 0.36;
    --slide: -20.5px;
    margin-right: auto;
    display: inline-flex;
    align-items: stretch;
    gap: 8px;
    padding-block: 1px;
    font: 800 19px/1 var(--font-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .nn-mark {
    position: relative;
    flex: none;
    width: 21px;
    height: 42px;
  }
  .nn-s {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    height: 42px;
    width: auto;
    color: var(--butter);
    filter: drop-shadow(3px 3px 0 var(--cobalt));
    transition: transform 0.26s var(--ease-out);
  }
  .nn-s.top {
    transform-origin: 0 11.9%;
  }
  .nn-s.bot {
    transform-origin: 0 82.6%;
  }
  .nn-lines {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2px 0 3px;
    transition: transform 0.26s var(--ease-out);
  }
  .nav-name:focus-visible .nn-s {
    transform: scale(var(--k));
  }
  .nav-name:focus-visible .nn-lines {
    transform: translateX(var(--slide));
  }
  @media (hover: hover) {
    .nav-name:hover .nn-s {
      transform: scale(var(--k));
    }
    .nav-name:hover .nn-lines {
      transform: translateX(var(--slide));
    }
  }
  /* The butter underline sweeps through: it wipes in from the left on hover
     and leaves to the right. Only the size animates; the anchor jumps from
     right to left while the line is empty or full, so the jump never shows.
     The active link keeps it. */
  .nav-link {
    background: linear-gradient(var(--butter), var(--butter)) right bottom / 0%
      2px no-repeat;
    transition: background-size 0.22s var(--ease-out);
  }
  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.is-active {
    background-position: left bottom;
    background-size: 100% 2px;
  }
  .nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: inline-block;
    padding-block: 6px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }

  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 2px solid var(--white);
    color: var(--white);
    cursor: pointer;
  }
  .nav-burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition:
      transform var(--dur-fast),
      opacity var(--dur-fast);
  }
  .nav-header.nav-open .nav-burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-header.nav-open .nav-burger span:nth-child(2) {
    opacity: 0;
  }
  .nav-header.nav-open .nav-burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile: the links become a night sheet that drops from the bar over a
     dimmed page, which stays still until the sheet closes. */
  @media (max-width: 768px) {
    .nav-inner {
      gap: 12px;
    }
    .nav-burger {
      display: inline-flex;
    }
    .nav-links {
      display: flex;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--night);
      border-bottom: var(--seam) solid var(--ink);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-10px);
      transition:
        opacity 0.16s,
        transform 0.22s var(--ease-out),
        visibility 0s 0.22s;
    }
    .nav-header.nav-open .nav-links {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.16s,
        transform 0.22s var(--ease-out);
    }
    /* The dim layer paints under the bar (z-index -1 inside the header's
       stacking context) and starts below its seam. A tap on it closes. */
    .nav-header::after {
      content: "";
      position: fixed;
      inset: calc(var(--nav-h) + var(--seam) + env(safe-area-inset-top, 0px)) 0
        0;
      z-index: -1;
      background: color-mix(in srgb, var(--scrim) 55%, transparent);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.2s,
        visibility 0s 0.2s;
    }
    .nav-header.nav-open::after {
      visibility: visible;
      opacity: 1;
      transition: opacity 0.2s;
    }
    :global(html:has(.nav-header.nav-open)) {
      overflow: hidden;
    }
    /* Scrolling down slides the bar away, as phone browsers do with their
       own; any scroll up, or focus inside it, brings it back. */
    .nav-header {
      transition: transform 0.25s var(--ease-out);
    }
    .nav-header.nav-away:not(:focus-within) {
      transform: translateY(-100%);
    }
    .nav-link:active {
      background: var(--night-press);
    }
    .nav-links li + li {
      border-top: 1px solid var(--night-rule);
    }
    .nav-link {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 56px;
      padding: 0 var(--gut);
      background: none;
      font: 800 22px/1 var(--font-display);
      text-transform: uppercase;
    }
    .nav-link::after {
      content: "→";
      color: var(--butter);
      font-family: var(--font-body);
    }
    .nav-link.is-active {
      color: var(--butter);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-header,
    .nav-header::after,
    .nav-links,
    .nn-s,
    .nn-lines,
    .nav-link,
    .nav-burger span {
      transition: none;
    }
    .nav-links {
      transform: none;
    }
  }
</style>
