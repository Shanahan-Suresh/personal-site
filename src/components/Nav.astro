---
import ThemeToggle from "./ThemeToggle.astro";
import { navLinks } from "@/data/navigation";
---

<header class="nav-header">
  <nav class="wrap nav-inner" aria-label="Main">
    <a href="/" class="nav-name" aria-label="Shanahan Suresh, home"
      >Shanahan Suresh</a
    >
    <button
      class="nav-burger"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul class="nav-links" role="list" id="mobile-nav">
      {
        navLinks.map((l) => (
          <li>
            <a href={l.href} class="nav-link">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--night);
    color: var(--white);
    border-bottom: var(--seam) solid var(--ink);
    --focus: var(--white);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--nav-h);
  }
  .nav-name {
    margin-right: auto;
    padding-block: 6px;
    font: 800 21px/1 var(--font-display);
    letter-spacing: 0.008em;
    text-transform: uppercase;
    text-decoration: none;
  }
  /* The butter underline wipes in from the left on hover; the active link keeps it. */
  .nav-name,
  .nav-link {
    background: linear-gradient(var(--butter), var(--butter)) left bottom / 0%
      2px no-repeat;
    transition: background-size 0.22s var(--ease-out);
  }
  .nav-name:hover,
  .nav-name:focus-visible,
  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.is-active {
    background-size: 100% 2px;
  }
  .nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: inline-block;
    padding-block: 6px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }

  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 2px solid var(--white);
    color: var(--white);
    cursor: pointer;
  }
  .nav-burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition:
      transform var(--dur-fast),
      opacity var(--dur-fast);
  }
  .nav-header.nav-open .nav-burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-header.nav-open .nav-burger span:nth-child(2) {
    opacity: 0;
  }
  .nav-header.nav-open .nav-burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile: the links become a night sheet under the bar. */
  @media (max-width: 768px) {
    .nav-inner {
      gap: 12px;
    }
    .nav-burger {
      display: inline-flex;
    }
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--night);
      border-bottom: var(--seam) solid var(--ink);
    }
    .nav-header.nav-open .nav-links {
      display: flex;
    }
    .nav-links li + li {
      border-top: 1px solid #3a362f;
    }
    .nav-link {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 56px;
      padding: 0 var(--gut);
      background: none;
      font: 800 22px/1 var(--font-display);
      text-transform: uppercase;
    }
    .nav-link::after {
      content: "→";
      color: var(--butter);
      font-family: var(--font-body);
    }
    .nav-link.is-active {
      color: var(--butter);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-name,
    .nav-link,
    .nav-burger span {
      transition: none;
    }
  }
</style>
