---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="nav-header">
  <nav class="container nav-inner">
    <a href="/" class="nav-wordmark">Shanahan Suresh</a>
    <div class="row gap-5 nav-right">
      <ul class="row gap-5 nav-links" role="list">
        <li><a href="/#work" class="mono nav-link">Work</a></li>
        <li><a href="/writing" class="mono nav-link">Writing</a></li>
        <li><a href="/#contact" class="mono nav-link">Contact</a></li>
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: var(--bw-thick) solid var(--ink);
    height: 68px;
    display: flex;
    align-items: center;
    transition: background var(--dur) var(--ease-out);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav-wordmark {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    position: relative;
  }
  .nav-wordmark::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent-2);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav-wordmark:hover::after {
    transform: scaleX(1);
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav-link:hover {
    color: var(--accent-1);
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
  }
</style>
