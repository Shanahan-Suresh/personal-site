---
import SectionHeading from "./SectionHeading.astro";
import BentoTile from "./BentoTile.astro";
import Tag from "./Tag.astro";
import { learning } from "@/data/skills";
---

<section id="skills" class="section">
  <div class="container">
    <SectionHeading eyebrow="CURRENTLY" title="What I'm into lately" />

    <div class="bento">
      <BentoTile span={4}>
        <div class="stack stack-4">
          <p>
            I'm getting deeper into deployment infrastructure and DevOps, using
            Terraform on real projects and teaching myself AWS. Kubernetes is
            next.
          </p>
          <p>
            Agentic coding takes up a lot of my day. I'm exploring how to build
            useful systems with LLMs, and how they change the way I work.
          </p>
        </div>
      </BentoTile>

      <BentoTile span={2} accent="1" stripe>
        <div class="stack stack-5">
          <h3 class="h3">On the learning list</h3>
          <div class="row-wrap gap-2">
            {learning.map((t) => <Tag>{t}</Tag>)}
          </div>
        </div>
      </BentoTile>
    </div>
  </div>
</section>
