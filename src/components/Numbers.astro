---
import { projects } from "@/data/projects";

const byId = (id: string) => {
  const p = projects.find((x) => x.id === id);
  if (!p) throw new Error(`Numbers strip: no project ${id}`);
  return p;
};
const rsvp = byId("rsvp");
const hr = byId("hr");
const ohse = byId("ohse");
const digest = byId("digest");

/* The headcount is not a row fact, so the build checks the HR story still says it. */
const employees = "20,000";
if (![hr.description].flat().some((d) => d.includes(employees))) {
  throw new Error(`Numbers strip: the HR story no longer says ${employees}`);
}

/* Each number opens the story that backs it, and no two open the same one. */
const items = [
  { value: rsvp.fact.value, label: "guests through one RSVP app", story: rsvp },
  {
    value: hr.fact.value,
    label: `faster pages for ${employees} employees`,
    story: hr,
  },
  {
    value: ohse.fact.value,
    label: "business units report safety incidents in one app",
    story: ohse,
  },
  {
    value: digest.fact.value,
    label: "news sources an AI turns into one email",
    story: digest,
  },
];
if (new Set(items.map((n) => n.story.id)).size !== items.length) {
  throw new Error("Numbers strip: two numbers open the same story");
}
---

<section class="slab s-cobalt nums" aria-label="Results">
  <ul class="nums-grid" role="list" data-stagger>
    {items.map((n) => (
      <li>
        <a
          class="num"
          data-hop
          href={`#story-${n.story.id}`}
          data-story={n.story.id}
          aria-haspopup="dialog"
        >
          <b data-hop-letters>{n.value}</b>
          <span class="what">{n.label}</span>
          <span class="cue label" aria-hidden="true">
            Story <span class="arrow">→</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .nums-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .nums-grid li {
    display: flex;
    border-left: var(--seam) solid var(--ink);
  }
  .nums-grid li:first-child {
    border-left: 0;
  }
  /* The whole cell is the link: it fills night, the number turns butter. */
  .num {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 30px var(--gut) 26px 28px;
    text-decoration: none;
    transition:
      background var(--dur-fast),
      color var(--dur-fast);
  }
  li:first-child .num {
    padding-left: var(--gut);
  }
  .num:hover,
  .num:focus-visible {
    background: var(--night);
    color: var(--white);
  }
  .num:hover b,
  .num:focus-visible b {
    color: var(--butter);
  }
  .num:focus-visible {
    outline: 4px solid var(--butter);
    outline-offset: -7px;
  }
  .cue {
    margin-top: auto;
    padding-top: 14px;
    font-size: 12px;
    opacity: 0.72;
    transition: opacity var(--dur-fast);
  }
  .num:hover .cue,
  .num:focus-visible .cue {
    opacity: 1;
  }
  b {
    display: block;
    font: 800 clamp(44px, 6.2vw, 92px) / 0.95 var(--font-display);
    letter-spacing: 0.008em;
    font-variant-numeric: lining-nums;
  }
  .what {
    display: block;
    max-width: 22ch;
    margin-top: 8px;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.35;
    text-wrap: balance;
  }
  @media (max-width: 960px) {
    .nums-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .nums-grid li:nth-child(3) {
      border-left: 0;
    }
    .nums-grid li:nth-child(3) .num {
      padding-left: var(--gut);
    }
    .nums-grid li:nth-child(n + 3) {
      border-top: var(--seam) solid var(--ink);
    }
  }
  @media (max-width: 560px) {
    .num {
      padding: 22px 16px 20px 20px;
    }
    .nums-grid li:nth-child(2n + 1) .num {
      padding-left: var(--gut);
    }
    .what {
      font-size: 15px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .num,
    .cue {
      transition: none;
    }
  }
</style>
