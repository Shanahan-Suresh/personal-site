---
import type { SlabTone } from "@/lib/types";

/* The title slab that opens every page except the homepage. */
interface Props {
  label?: string;
  title: string;
  intro?: string;
  tone?: SlabTone;
}

const { label, title, intro, tone = "cobalt" } = Astro.props;
---

<header class={`slab s-${tone}`}>
  <div class="wrap page-head">
    <slot name="before" />
    {label && <span class="label">{label}</span>}
    <h1>{title}</h1>
    {intro && <p class="intro">{intro}</p>}
    <slot />
  </div>
</header>

<style>
  .page-head {
    padding-block: 64px 56px;
  }
  .label {
    display: block;
    margin-bottom: 18px;
  }
  h1 {
    max-width: 16ch;
    font-size: clamp(56px, 9vw, 136px);
  }
  .intro {
    max-width: 56ch;
    margin: 28px 0 0;
    font-size: 19px;
  }
  @media (max-width: 560px) {
    .page-head {
      padding-block: 44px 40px;
    }
    .intro {
      font-size: 17.5px;
    }
  }
</style>
