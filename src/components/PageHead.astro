---
import type { SlabTone } from "@/lib/types";

/* The title slab that opens every page except the homepage. */
interface Props {
  label?: string;
  title: string;
  intro?: string;
  tone?: SlabTone;
}

const { label, title, intro, tone = "cobalt" } = Astro.props;
const hasAside = Astro.slots.has("aside");
---

<header class={`slab s-${tone}`}>
  <div class={`wrap page-head${hasAside ? " has-aside" : ""}`}>
    <div>
      <slot name="before" />
      {label && <span class="label">{label}</span>}
      <h1>{title}</h1>
      {intro && <p class="intro">{intro}</p>}
      <slot />
    </div>
    {hasAside && (
      <div class="page-head-aside">
        <slot name="aside" />
      </div>
    )}
  </div>
</header>

<style>
  .page-head {
    padding-block: 64px 56px;
  }
  .label {
    display: block;
    margin-bottom: 18px;
  }
  h1 {
    max-width: 16ch;
    font-size: clamp(56px, 9vw, 136px);
  }
  .intro {
    max-width: 56ch;
    margin: 28px 0 0;
    font-size: 19px;
  }
  /* A page that gives the title a picture: title left, picture right. The
     picture drops out below 960px, where the title needs the width. */
  .has-aside {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 56px;
    align-items: center;
  }
  .has-aside h1 {
    font-size: clamp(56px, 7vw, 112px);
  }
  @media (max-width: 960px) {
    .has-aside {
      display: block;
    }
    .page-head-aside {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .page-head {
      padding-block: 44px 40px;
    }
    .intro {
      font-size: 17.5px;
    }
  }
</style>
