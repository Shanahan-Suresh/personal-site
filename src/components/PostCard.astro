---
import { formatPostDate, type Post } from "../lib/posts";

interface Props {
  post: Post;
  showTags?: boolean;
}

const { post, showTags = false } = Astro.props;
const tags = showTags ? (post.data.tags ?? []) : [];
---

<li>
  <a class="post row-link" href={`/writing/${post.id}`}>
    <time class="label" datetime={post.data.pubDate.toISOString()}
      >{formatPostDate(post.data.pubDate)}</time
    >
    <span class="text">
      <span class="title">{post.data.title}</span>
      <span class="desc">{post.data.description}</span>
      {
        tags.length > 0 && (
          <span class="tags">
            {tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </span>
        )
      }
    </span>
    <span class="go" aria-hidden="true">Read →</span>
  </a>
</li>

<style>
  li {
    border-bottom: var(--seam) solid var(--edge);
  }
  li:first-child {
    border-top: var(--seam) solid var(--edge);
  }
  .post {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: 24px;
    align-items: start;
    padding: 26px 16px;
    margin-inline: -16px;
  }
  .label {
    padding-top: 6px;
  }
  .title {
    display: block;
    font: 800 clamp(28px, 3.2vw, 44px) / 0.95 var(--font-display);
    letter-spacing: 0.008em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .desc {
    display: block;
    max-width: 62ch;
    margin-top: 10px;
    font-size: 17px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .tags span {
    padding: 4px 9px;
    border: 2px solid currentColor;
    font: 500 12px/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .go {
    padding-top: 6px;
    font: 500 13px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 720px) {
    .post {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .label,
    .go {
      padding-top: 0;
    }
  }
</style>
