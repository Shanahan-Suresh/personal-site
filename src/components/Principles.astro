---
const principles = [
  {
    title: "Make it a joy to use",
    body: "People remember how software feels. Every design decision should start there.",
  },
  {
    title: "Love is in the details",
    body: "Small rough edges add up. I'll happily go the extra mile on the little interactions.",
  },
  {
    title: "Let robots handle the boring bits",
    body: "Life's too short for repetitive work. I hand it to LLMs and keep the fun parts for myself.",
  },
];
---

<section class="slab s-paper" aria-labelledby="rules-title">
  <h2 id="rules-title" class="sr-only">Principles I build by</h2>
  <ul class="wrap rules" role="list">
    {
      principles.map((p) => (
        <li>
          <span class="label" aria-hidden="true">
            I build by
          </span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .rules {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-block: 0;
    list-style: none;
  }
  li {
    padding: 48px 32px 52px;
    border-left: var(--seam) solid var(--edge);
  }
  li:first-child {
    border-left: 0;
    padding-left: 0;
  }
  li:last-child {
    padding-right: 0;
  }
  h3 {
    margin: 16px 0;
    font-size: clamp(34px, 3.4vw, 48px);
    line-height: 0.92;
  }
  p {
    max-width: 36ch;
    margin: 0;
    font-size: 17px;
  }
  @media (max-width: 960px) {
    .rules {
      grid-template-columns: 1fr;
    }
    li,
    li:last-child {
      padding: 32px 0;
      border-left: 0;
      border-top: var(--seam) solid var(--edge);
    }
    li:first-child {
      border-top: 0;
    }
  }
</style>
