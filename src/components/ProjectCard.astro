---
import Card from "./Card.astro";
import MediaFrame from "./MediaFrame.astro";
import type { Project, Accent } from "@/lib/types";

interface Props {
  project: Project;
  num?: string;
  accent?: Accent;
  class?: string;
  style?: string;
}

const {
  project,
  num,
  accent = "1",
  class: className = "",
  style: styleProp = "",
} = Astro.props;
const {
  title,
  description,
  tags = [],
  link,
  meta,
  featured,
  media,
  evidence,
} = project;
---

<Card
  press
  accent={accent}
  stripe
  class={`project-card ${featured ? "project-card--featured" : ""} ${className}`}
  style={styleProp}
  data-tilt
>
  {
    num && (
      <span class="ghost-num" aria-hidden="true">
        {num}
      </span>
    )
  }

  <div class="stack project-body">
    <div class="row between gap-3 title-row">
      <h3 class="h3 project-title">{title}</h3>
      {meta && <span class="tag tag-ink meta-tag">{meta}</span>}
    </div>

    {
      evidence?.kind === "workflow" && (
        <figure class="project-evidence workflow-evidence">
          <ol aria-label="Incident workflow">
            {evidence.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          <figcaption>{evidence.caption}</figcaption>
        </figure>
      )
    }

    {
      evidence?.kind === "performance" && (
        <figure class="project-evidence performance-evidence">
          <figcaption>{evidence.caption}</figcaption>
          <div class="comparison-row">
            <>
              <span>Before</span>
              <span class="comparison-track">
                <span class="comparison-bar comparison-before" />
              </span>
              <span>100%</span>
            </>
          </div>
          <div class="comparison-row">
            <>
              <span>After</span>
              <span class="comparison-track">
                <span
                  class="comparison-bar comparison-after"
                  style={`width:${100 - evidence.reduction}%`}
                />
              </span>
              <span>{100 - evidence.reduction}%</span>
            </>
          </div>
          <p class="comparison-note">Relative page-load time</p>
        </figure>
      )
    }

    {
      Array.isArray(description) ? (
        <div class="project-desc-group">
          {description.map((para) => (
            <p class="muted project-desc">{para}</p>
          ))}
        </div>
      ) : (
        <p class="muted project-desc">{description}</p>
      )
    }

    {
      tags.length > 0 && (
        <div class="row-wrap gap-2 tags-row">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }

    {
      link && (
        <div class="project-link">
          <a
            href={link.href}
            class="tag link-anchor arrow-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.label}
          </a>
        </div>
      )
    }
  </div>

  {
    media && (
      <div class="project-visual">
        <MediaFrame
          image={media.image}
          alt={media.alt}
          caption={media.caption}
          fit={media.fit}
          aspectRatio={media.aspectRatio}
          widths={[480, 720, 1040]}
          sizes={
            featured
              ? "(max-width: 900px) 88vw, 520px"
              : "(max-width: 700px) 88vw, 480px"
          }
        />
      </div>
    )
  }
</Card>

<style>
  .project-card {
    height: 100%;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .ghost-num {
    position: absolute;
    top: -0.1em;
    right: 0.3rem;
    font-size: clamp(4rem, 9vw, 7rem);
    line-height: 0.85;
    pointer-events: none;
  }

  .project-body {
    flex: 1;
    gap: var(--space-4);
  }

  .title-row {
    align-items: flex-start;
  }

  .project-title {
    position: relative;
  }

  .meta-tag {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .project-desc {
    position: relative;
    line-height: 1.65;
  }

  .project-desc-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .tags-row {
    position: relative;
  }

  .project-link {
    margin-top: auto;
    padding-top: var(--space-3);
  }

  /* the link tag picks up its card's accent so it reads as part of the card */
  .link-anchor {
    background: var(--card-accent);
    color: var(--card-on-accent);
    text-decoration: none;
  }

  /* ── Featured variant: full grid width, copy beside a framed visual ────── */
  .project-card--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 520px);
    gap: var(--space-6);
    align-items: start;
  }
  .project-card--featured .ghost-num {
    /* keep the numeral behind the copy, clear of the visual */
    right: auto;
    left: 40%;
  }
  .project-visual {
    margin: 0;
    position: relative;
    order: -1;
  }
  .project-card--featured .project-visual {
    order: 0;
  }
  .project-evidence {
    margin: 0;
    padding: var(--space-4);
    border: var(--border);
    background: var(--surface-2);
  }
  .project-evidence figcaption {
    font-size: var(--fs-sm);
    font-weight: 650;
  }
  .workflow-evidence ol {
    display: flex;
    align-items: center;
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
    gap: var(--space-2);
  }
  .workflow-evidence li {
    display: flex;
    align-items: center;
    font-weight: 700;
    font-size: clamp(0.78rem, 1.1vw, 1rem);
  }
  .workflow-evidence li + li::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-top: var(--border);
    border-right: var(--border);
    transform: rotate(45deg);
    margin-right: var(--space-3);
  }
  .performance-evidence figcaption {
    margin-bottom: var(--space-3);
  }
  .comparison-row {
    display: grid;
    grid-template-columns: 3.2rem 1fr 2.7rem;
    gap: var(--space-2);
    align-items: center;
    font-size: 0.78rem;
    margin-top: var(--space-2);
  }
  .comparison-track {
    display: block;
    height: 1rem;
    background: var(--surface);
    border: 1px solid var(--ink);
  }
  .comparison-bar {
    display: block;
    height: 100%;
  }
  .comparison-before {
    width: 100%;
    background: var(--ink-soft);
  }
  .comparison-after {
    background: var(--accent-1);
  }
  .comparison-note {
    color: var(--ink-soft);
    font-size: 0.75rem;
    margin-top: var(--space-3);
  }
  @media (max-width: 900px) {
    .project-card--featured {
      grid-template-columns: 1fr;
    }
    .project-card--featured .ghost-num {
      left: auto;
      right: 0.3rem;
    }
    .project-card--featured .project-visual {
      order: -1;
    }
  }
</style>
