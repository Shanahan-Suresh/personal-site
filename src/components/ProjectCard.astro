---
import Card from './Card.astro';

interface Props {
  title: string;
  description: string;
  tags?: string[];
  link?: { label: string; href: string };
  meta?: string;
  num?: string;
  accent?: '1' | '2' | 'pop' | 'ink';
  class?: string;
  style?: string;
}

const { title, description, tags = [], link, meta, num, accent = '1', class: className = '', style: styleProp = '' } = Astro.props;

const cardStyle = ['height:100%;position:relative;overflow:hidden;', styleProp].filter(Boolean).join('');
---

<Card press accent={accent} stripe class={className} style={cardStyle}>
  {num && (
    <span
      class="ghost-num"
      aria-hidden="true"
      style="position:absolute;top:-0.1em;right:0.3rem;font-size:clamp(4rem,9vw,7rem);line-height:0.85;pointer-events:none;"
    >{num}</span>
  )}

  <div class="stack" style="height:100%;gap:var(--space-4);">
    <div class="row between gap-3" style="align-items:flex-start;">
      <h3 class="h3" style="position:relative;">{title}</h3>
      {meta && (
        <span class="tag tag-ink" style="flex-shrink:0;white-space:nowrap;">{meta}</span>
      )}
    </div>

    <p class="muted" style="position:relative;line-height:1.65;">{description}</p>

    {tags.length > 0 && (
      <div class="row-wrap gap-2" style="position:relative;">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    {link && (
      <div style="margin-top:auto;padding-top:var(--space-3);">
        <a
          href={link.href}
          class="tag tag-pop"
          target="_blank"
          rel="noopener noreferrer"
          style="text-decoration:none;"
        >
          {link.label} ↗
        </a>
      </div>
    )}
  </div>
</Card>
