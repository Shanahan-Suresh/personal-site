---
import GlassCard from './GlassCard.astro';

interface Props {
  title: string;
  description: string;
  tags?: string[];
  link?: { label: string; href: string };
  meta?: string;
}

const { title, description, tags = [], link, meta } = Astro.props;
---

<GlassCard tier={2} glow={true} class="lift reveal flex-col" style="height:100%;">
  <div class="flex-col gap-4" style="padding:var(--space-6);height:100%;">
    <div class="flex-row items-start gap-3" style="justify-content:space-between;">
      <h3 class="h3">{title}</h3>
      {meta && (
        <span class="text-xs muted" style="font-family:var(--font-mono);white-space:nowrap;padding:0.2rem 0.6rem;border-radius:var(--radius-full);border:1px solid var(--hairline);">{meta}</span>
      )}
    </div>

    <p class="prose-body text-sm">{description}</p>

    {tags.length > 0 && (
      <div class="flex-row wrap gap-2">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    {link && (
      <div style="margin-top:auto;padding-top:var(--space-3);">
        <a
          href={link.href}
          class="btn btn-ghost text-sm"
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.label} ↗
        </a>
      </div>
    )}
  </div>
</GlassCard>
