---
import { Image, getImage } from "astro:assets";
import type { ListedProject } from "@/lib/types";
import ArrowText from "./ArrowText.astro";

interface Props {
  project: ListedProject;
}

const { project: p } = Astro.props;
const crop = p.media?.objectPosition ?? "top";

/* The pointer preview loads one of these on first hover, never with the page:
   the 960px file on any screen denser than 1x (the panel is up to 460px wide), the 480px
   file otherwise. The attribute is data-peek-hd: a digit after a hyphen (data-peek-2x)
   does not map to a camelCase dataset key. */
const peekAt = (width: number) =>
  p.media
    ? getImage({ src: p.media.image, width, format: "webp", quality: 75 })
    : null;
const [peek, peekHd] = await Promise.all([peekAt(480), peekAt(960)]);
---

<li>
  <a
    class="pr row-link"
    id={`row-${p.id}`}
    href={`#story-${p.id}`}
    data-story={p.id}
    data-peek={peek?.src}
    data-peek-hd={peekHd?.src}
    data-peek-pos={crop}
    data-peek-ratio={p.media && p.media.image.width / p.media.image.height}
    data-peek-cap={p.media?.caption}
    aria-haspopup="dialog"
  >
    <span class="hd">
      <span class="grp label">{p.group}</span>
      <span class="t">
        <ArrowText text={p.title} />
      </span>
    </span>
    <span class="fa">
      <b>
        {p.fact.value} {p.fact.label}
      </b>
      <span>{p.summary}</span>
    </span>
    <span class="go">
      Story{" "}
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </span>
    {p.media && (
      <Image
        class="thumb"
        src={p.media.image}
        alt=""
        aria-hidden="true"
        format="webp"
        quality={75}
        widths={[400, 600, 800, 1040]}
        sizes="(max-width: 560px) 92vw, 560px"
        loading="lazy"
        decoding="async"
        style={`object-position:${crop}`}
      />
    )}
  </a>
</li>

<style>
  li {
    border-bottom: var(--seam) solid var(--white);
  }
  .pr {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) 150px;
    gap: 28px;
    align-items: center;
    padding: 28px 20px;
  }

  /* The title steps forward on hover. */
  .t {
    display: block;
    font: 800 clamp(30px, 3.6vw, 54px) / 0.92 var(--font-display);
    letter-spacing: 0.008em;
    text-transform: uppercase;
    text-wrap: balance;
    transition: transform 0.2s var(--ease-out);
  }
  .grp {
    display: block;
    margin-bottom: 10px;
  }
  .fa b {
    display: block;
    margin-bottom: 6px;
    font: 800 24px/1.05 var(--font-display);
    letter-spacing: 0.008em;
  }
  .fa span {
    display: block;
    font-size: 16px;
    line-height: 1.45;
  }
  .go {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: var(--seam) solid currentColor;
    font: 500 13px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      transform 0.1s,
      background var(--dur-fast),
      color var(--dur-fast);
  }
  .pr:hover .go,
  .pr:focus-visible .go {
    background: var(--ink);
    color: var(--butter);
    border-color: var(--ink);
    transform: translate(-2px, -2px);
  }
  .pr:hover .arrow,
  .pr:focus-visible .arrow {
    transform: translateX(3px);
  }
  .thumb {
    display: none;
  }

  @media (hover: hover) and (min-width: 961px) {
    .pr:hover .t,
    .pr:focus-visible .t {
      transform: translateX(10px);
    }
  }

  /* Phones and tablets: the picture leads and the Story tab sits on its
     corner. */
  @media (max-width: 960px) {
    .pr {
      grid-template-columns: minmax(0, 560px);
      grid-template-areas:
        "pic"
        "hd"
        "fa";
      gap: 14px 14px;
      padding: 24px 20px 26px;
    }
    .hd {
      grid-area: hd;
    }
    .fa {
      grid-area: fa;
    }
    .thumb {
      grid-area: pic;
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      border: var(--seam) solid var(--ink);
      background: var(--white);
      box-shadow: var(--hard-5) var(--ink);
    }
    .go {
      grid-area: pic;
      z-index: 1;
      align-self: end;
      justify-self: end;
      margin: 0 -10px -14px 0;
      padding: 9px 11px;
      border-color: var(--ink);
      background: var(--butter);
      color: var(--ink);
      box-shadow: var(--hard-3) var(--ink);
    }
    .pr:hover .go,
    .pr:focus-visible .go,
    .pr:active .go {
      background: var(--ink);
      color: var(--butter);
      transform: none;
    }
    .fa b {
      font-size: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .go,
    .t {
      transition: none;
    }
  }
</style>
