---
import { Image, getImage } from "astro:assets";
import type { ListedProject } from "@/data/projects";

interface Props {
  project: ListedProject;
  index: number;
}

const { project: p, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");

/* The pointer preview loads this small file on first hover, never with the page. */
const peek = p.media
  ? await getImage({
      src: p.media.image,
      width: 480,
      format: "webp",
      quality: 75,
    })
  : null;
---

<li>
  <a
    class="pr"
    id={`row-${p.id}`}
    href={`#story-${p.id}`}
    data-story={p.id}
    data-peek={peek?.src}
    aria-haspopup="dialog"
  >
    <span class="ix">{num}</span>
    <span>
      <span class="grp">{p.group}</span>
      <span class="t">{p.title}</span>
    </span>
    <span class="fa">
      <b>{p.fact.value} {p.fact.label}</b>
      <span>{p.summary}</span>
    </span>
    <span class="go">Story <span aria-hidden="true">→</span></span>
    {
      p.media && (
        <Image
          class="thumb"
          src={p.media.image}
          alt=""
          format="webp"
          quality={75}
          widths={[400, 600, 800]}
          sizes="(max-width: 560px) 90vw, 520px"
          loading="lazy"
          decoding="async"
        />
      )
    }
  </a>
</li>

<style>
  li {
    border-bottom: var(--seam) solid var(--white);
  }
  .pr {
    display: grid;
    grid-template-columns: 56px minmax(0, 1.25fr) minmax(0, 1fr) 150px;
    gap: 28px;
    align-items: center;
    padding: 28px 20px;
    text-decoration: none;
    transition:
      background var(--dur-fast),
      color var(--dur-fast);
  }
  .pr:hover,
  .pr:focus-visible {
    background: var(--butter);
    color: var(--ink);
  }
  .pr:focus-visible {
    outline: 0;
    box-shadow: inset 0 0 0 4px var(--ink);
  }
  .ix {
    align-self: start;
    padding-top: 6px;
    font: 500 14px/1 var(--font-mono);
    letter-spacing: 0.06em;
  }
  .grp {
    display: block;
    margin-bottom: 10px;
    font: 500 13px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .t {
    display: block;
    font: 800 clamp(30px, 3.6vw, 54px) / 0.92 var(--font-display);
    letter-spacing: 0.008em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .fa b {
    display: block;
    margin-bottom: 6px;
    font: 800 24px/1.05 var(--font-display);
    letter-spacing: 0.008em;
  }
  .fa span {
    display: block;
    font-size: 16px;
    line-height: 1.45;
  }
  .go {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: var(--seam) solid currentColor;
    font: 500 13px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      transform 0.1s,
      background var(--dur-fast),
      color var(--dur-fast);
  }
  .pr:hover .go,
  .pr:focus-visible .go {
    background: var(--ink);
    color: var(--butter);
    border-color: var(--ink);
    transform: translate(-2px, -2px);
  }
  .thumb {
    display: none;
  }

  @media (max-width: 960px) {
    .pr {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .ix {
      padding: 0;
    }
    .go {
      justify-self: start;
    }
    .thumb {
      display: block;
      width: 100%;
      max-width: 520px;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      object-position: top;
      border: var(--seam) solid var(--ink);
      background: var(--white);
      box-shadow: 5px 5px 0 var(--ink);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pr,
    .go {
      transition: none;
    }
  }
</style>
