---
import { getImage } from "astro:assets";
import MediaFrame from "./MediaFrame.astro";
import ArrowText from "./ArrowText.astro";
import type { ListedProject } from "@/data/projects";

interface Props {
  project: ListedProject;
  prev: ListedProject;
  next: ListedProject;
}

const { project: p, prev, next } = Astro.props;
/* The capture at its own size, opened from the caption so small UI text can be read. */
const full = p.media
  ? await getImage({ src: p.media.image, format: "webp", quality: 85 })
  : null;
const paragraphs = [p.description].flat();
const nextTitle =
  next.title.length > 26 ? next.title.slice(0, 24).trim() + "…" : next.title;
---

<dialog
  class="story"
  id={`story-${p.id}`}
  aria-labelledby={`story-${p.id}-title`}
  data-prev={prev.id}
  data-next={next.id}
>
  <div class="st-head">
    <div>
      <span class="label">{p.group}</span>
      <h2 id={`story-${p.id}-title`}>
        <ArrowText text={p.title} />
      </h2>
    </div>
    <a class="st-x" href={`#row-${p.id}`} data-close aria-label="Close story">
      <svg
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M2.5 2.5l11 11M13.5 2.5l-11 11"></path>
      </svg>
    </a>
  </div>
  <div class="st-body">
    {p.media && (
      <MediaFrame
        image={p.media.image}
        alt={p.media.alt}
        aspectRatio={p.media.aspectRatio}
        widths={[480, 720, 1040]}
        sizes="(max-width: 960px) 90vw, 560px"
      >
        <Fragment slot="caption">
          {p.media.caption}
          {full && (
            <a class="st-full" href={full.src} target="_blank" rel="noopener">
              Open full size <span class="arrow out">↗</span>
            </a>
          )}
        </Fragment>
      </MediaFrame>
    )}
    <div>
      <p class="st-fact">
        {p.fact.value}
        <small>{p.fact.label}</small>
      </p>
      {paragraphs.map((d) => (
        <p>{d}</p>
      ))}
      {p.tags && (
        <ul class="tags chips" role="list">
          {p.tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )}
      {p.link && (
        <div class="st-actions">
          <a
            class="btn"
            href={p.link.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {p.link.label} <span class="arrow out">↗</span>
          </a>
        </div>
      )}
      <nav class="st-nav" aria-label="More stories">
        <a
          class="btn btn-alt"
          href={`#story-${prev.id}`}
          data-go={prev.id}
          data-dir="prev"
          aria-label={`Previous story: ${prev.title}`}
        >
          <span class="arrow back" aria-hidden="true">
            ←
          </span>
          <span class="st-go">Previous</span>
        </a>
        <a
          class="btn btn-alt"
          href={`#story-${next.id}`}
          data-go={next.id}
          data-dir="next"
          data-next={next.id}
        >
          <span class="st-go">
            Next:{" "}
            <span class="t-short">
              <ArrowText text={nextTitle} />
            </span>
            <span class="t-full">
              <ArrowText text={next.title} />
            </span>
          </span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </nav>
    </div>
  </div>
</dialog>

<style>
  /* The Next button's title: cut to fit one line on wider screens, whole
     on a phone, where the button wraps to two lines. */
  .t-full {
    display: none;
  }
  .story {
    margin: auto; /* Tailwind's reset zeroes the margin that centres a modal */
    width: min(1080px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    overflow: auto;
    border: var(--seam) solid var(--edge);
    background: var(--card);
    color: var(--text);
    box-shadow: var(--hard-10) var(--edge);
    --focus: var(--edge);
  }
  .story::backdrop {
    background: rgb(10 9 7 / 0.72);
  }
  /* Until the story script runs (stories.ts adds `.stories`), the link
     target shows the story as a fixed panel. */
  :global(html:not(.stories)) .story:target {
    display: block;
    position: fixed;
    inset: 16px;
    z-index: 60;
    margin: auto;
    height: fit-content;
  }
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
  .st-head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 16px;
    padding: 22px 28px;
    border-bottom: var(--seam) solid var(--edge);
    background: var(--card);
  }
  .st-head h2 {
    margin-top: 8px;
    font-size: clamp(34px, 5vw, 64px);
  }
  /* The close control: a bold drawn ink cross on butter. Hover and focus
     lift it into its shadow; a press sinks it. */
  .st-x {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: var(--seam) solid var(--edge);
    background: var(--butter);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.1s,
      box-shadow 0.1s;
  }
  .st-x:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: var(--hard-3) var(--edge);
  }
  @media (hover: hover) {
    .st-x:hover {
      transform: translate(-2px, -2px);
      box-shadow: var(--hard-3) var(--edge);
    }
  }
  .st-x:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }
  .st-body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 32px;
    padding: 28px;
  }
  .st-body :global(.frame) {
    align-self: start;
    border-color: var(--edge);
    box-shadow: var(--hard-6) var(--edge);
  }
  .st-body p {
    margin: 20px 0;
    font-size: 17.5px;
  }
  .st-body .st-fact {
    margin: 0;
    font: 800 clamp(48px, 6vw, 84px) / 0.9 var(--font-display);
    letter-spacing: 0.008em;
    text-transform: uppercase;
  }
  .st-fact small {
    display: block;
    margin-top: 8px;
    font: 600 16px/1.3 var(--font-body);
    letter-spacing: 0;
    text-transform: none;
  }
  .tags {
    margin: 0 0 22px;
  }
  .st-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .st-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
    padding-top: 22px;
    border-top: 2px solid var(--edge);
  }
  .st-full {
    display: block;
    width: fit-content;
    margin-top: 6px;
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .st-actions .btn,
  .st-nav .btn {
    border-color: var(--edge);
    box-shadow: var(--hard-4) var(--edge);
    font-size: 15px;
    white-space: normal;
  }
  /* The arrow and its label are separate spans, so the gap spaces them. */
  .st-nav .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .st-actions .btn:focus-visible,
  .st-nav .btn:focus-visible {
    box-shadow: var(--hard-6) var(--edge);
  }
  @media (hover: hover) {
    .st-actions .btn:hover,
    .st-nav .btn:hover {
      box-shadow: var(--hard-6) var(--edge);
    }
  }
  .st-actions .btn:active,
  .st-nav .btn:active {
    box-shadow: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .story[open] {
      animation: story-pop 0.18s ease-out;
    }
    .story[open]::backdrop {
      animation: story-dim 0.2s ease-out;
    }
    @keyframes story-dim {
      from {
        opacity: 0;
      }
    }
    /* Moving between stories slides the new one in from the side it comes from. */
    .story[open][data-enter="next"] {
      animation-name: story-from-right;
    }
    .story[open][data-enter="prev"] {
      animation-name: story-from-left;
    }
    @keyframes story-pop {
      from {
        transform: translateY(14px);
        opacity: 0;
      }
    }
    @keyframes story-from-right {
      from {
        transform: translateX(16px);
        opacity: 0;
      }
    }
    @keyframes story-from-left {
      from {
        transform: translateX(-16px);
        opacity: 0;
      }
    }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 560px) {
    .story[open]:not([data-enter]) {
      animation: story-rise 0.3s var(--ease-out);
    }
    @keyframes story-rise {
      from {
        transform: translateY(100%);
      }
    }
  }
  @media (max-width: 960px) {
    .st-body {
      grid-template-columns: 1fr;
    }
  }
  /* On a phone the story is a sheet that rises from the bottom edge and
     fills the screen but for a strip of dimmed page at the top. The head
     stays small, so the picture shows on the first screen, and carries a
     grab bar: pulling it down closes the sheet (scripts/home/stories.ts).
     Previous and Next ride in a bar pinned to the bottom, under the thumb. */
  @media (max-width: 560px) {
    .story {
      width: 100%;
      max-width: 100%;
      height: calc(100dvh - 12px);
      max-height: calc(100dvh - 12px);
      margin: auto 0 0;
      border-width: var(--seam) 0 0;
      box-shadow: none;
      overscroll-behavior: contain;
    }
    .st-head {
      padding: 20px 14px 12px 18px;
    }
    .st-head::before {
      content: "";
      position: absolute;
      top: 7px;
      left: 50%;
      width: 40px;
      height: 4px;
      margin-left: -20px;
      background: var(--muted);
      opacity: 0.6;
    }
    .st-head h2 {
      margin-top: 4px;
      font-size: 30px;
    }
    .st-body {
      gap: 24px;
      padding: 18px 18px 0;
    }
    .st-nav {
      position: sticky;
      bottom: 0;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 10px;
      margin: 28px -18px 0;
      padding: 12px 18px calc(14px + env(safe-area-inset-bottom, 0px));
      border-top: var(--seam) solid var(--edge);
      background: var(--card);
    }
    .st-nav .btn {
      display: flex;
      justify-content: center;
      min-height: 48px;
      padding: 12px 14px;
      box-shadow: var(--hard-3) var(--edge);
      white-space: nowrap;
    }
    /* The Next button names the next story in full: a long title wraps to a
       second line rather than losing its end. */
    .st-nav .btn[data-dir="next"] {
      align-items: center;
      gap: 8px;
      white-space: normal;
      text-align: left;
    }
    .st-go {
      text-wrap: balance;
    }
    .t-short {
      display: none;
    }
    .t-full {
      display: inline;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .st-x {
      transition: none;
    }
  }
</style>
