---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<div class="reveal" style="margin-bottom:var(--space-7);">
  {eyebrow && <p class="section-label">{eyebrow}</p>}
  <h2 class="section-title">{title}</h2>
  {
    intro && (
      <p class="lead" style="margin-top:var(--space-4);">
        {intro}
      </p>
    )
  }
</div>
