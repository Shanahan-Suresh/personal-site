<button id="theme-toggle" aria-label="Toggle dark mode" class="theme-btn">
  <svg
    id="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle><path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <svg
    id="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--surface);
    color: var(--ink);
    border: var(--border-thick);
    border-radius: var(--radius);
    box-shadow: var(--shadow-hard-sm);
    cursor: pointer;
    padding: 0;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
    flex-shrink: 0;
  }
  .theme-btn:hover {
    transform: translate(var(--off-sm), var(--off-sm));
    box-shadow: 0 0 0 var(--ink);
  }
  .theme-btn:active {
    transform: translate(var(--off), var(--off));
    box-shadow: 0 0 0 var(--ink);
  }
  .theme-btn svg {
    transition: transform var(--dur-fast) var(--ease-snap);
  }
  .theme-btn:active svg {
    transform: rotate(90deg);
  }
  /* click feedback: light gray when switching to dark, black to light */
  .theme-btn.flash-dark {
    border-color: #cfcfcf;
    box-shadow: var(--off-sm) var(--off-sm) 0 #cfcfcf;
  }
  .theme-btn.flash-light {
    border-color: #000;
    box-shadow: var(--off-sm) var(--off-sm) 0 #000;
  }
  #icon-sun {
    display: none;
  }
  #icon-moon {
    display: block;
  }
  :global(html.dark) #icon-sun {
    display: block;
  }
  :global(html.dark) #icon-moon {
    display: none;
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    btn?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const flashClass = isDark ? "flash-dark" : "flash-light";
        btn.classList.add(flashClass);
        setTimeout(function () {
          btn.classList.remove(flashClass);
        }, 180);
      }
    });
  }
  initThemeToggle();
  document.addEventListener("astro:page-load", initThemeToggle);
</script>
