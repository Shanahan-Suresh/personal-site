---
import { BAYER_8 } from "@/lib/bayer";
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  aria-pressed="false"
  class="theme-btn"
>
  <!-- 8 x 8 ordered dither (Bayer): --o is the order each square fills in. -->
  <span class="dither" aria-hidden="true">
    {BAYER_8.map((o) => <i style={`--o:${o}`} />)}
  </span>
  <svg
    id="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle><path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <svg
    id="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
  </svg>
</button>

<style>
  /* A round button, the one owner-approved radius in the nav. Under a mouse
     or keyboard focus it fades in with butter square by square, in an 8 x 8
     ordered dither, the same Bayer pattern as the page dissolve the click
     starts, so the hover is a small preview of the switch. Leaving plays it
     backwards. */
  .theme-btn {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    border: 2px solid var(--white);
    background: none;
    color: var(--white);
    cursor: pointer;
    transition:
      border-color 0s 0.1s,
      color 0s 0.06s;
  }
  /* Both icons sit in one cell. The icon always shows the theme in use;
     a click switches it once, and the hover never previews the other one. */
  .theme-btn svg {
    position: relative;
    grid-area: 1 / 1;
    transition: opacity 0s 0.06s;
  }
  #icon-moon,
  :global(html.dark) #icon-sun {
    opacity: 0;
  }
  :global(html.dark) #icon-moon {
    opacity: 1;
  }
  .dither {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
    display: grid;
    grid-template: repeat(8, 1fr) / repeat(8, 1fr);
    pointer-events: none;
  }
  .dither i {
    background: var(--butter);
    opacity: 0;
    transition: opacity 0s calc((63 - var(--o)) * 4ms);
  }
  .theme-btn:focus-visible,
  .theme-btn:active {
    border-color: var(--butter);
    color: var(--ink);
    transition:
      border-color 0s,
      color 0s 0.1s;
  }
  .theme-btn:focus-visible .dither i,
  .theme-btn:active .dither i {
    opacity: 1;
    transition-delay: calc(var(--o) * 6ms);
  }
  @media (hover: hover) {
    .theme-btn:hover {
      border-color: var(--butter);
      color: var(--ink);
      transition:
        border-color 0s,
        color 0s 0.1s;
    }
    .theme-btn:hover .dither i {
      opacity: 1;
      transition-delay: calc(var(--o) * 6ms);
    }
  }
  /* Press sinks. */
  .theme-btn:active svg {
    transform: translateY(1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-btn,
    .theme-btn:hover,
    .theme-btn:focus-visible,
    .theme-btn:active,
    .dither i,
    .theme-btn:hover .dither i,
    .theme-btn:focus-visible .dither i,
    .theme-btn:active .dither i {
      transition: none;
    }
  }
  @media (max-width: 768px) {
    .theme-btn {
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  import { BAYER_8 } from "@/lib/bayer";

  function initThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const show = (dark: boolean) =>
      btn.setAttribute("aria-pressed", String(dark));
    show(document.documentElement.classList.contains("dark"));
    const root = document.documentElement;
    const apply = () => {
      const isDark = root.classList.toggle("dark");
      show(isDark);
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch {
        // Storage can be blocked; the theme still applies for this visit.
      }
    };
    /* With a mouse, the switch is a pixel dissolve from this button. Going to
       dark, the dark page is cut in through a growing circle whose edge breaks
       into square pixels in an ordered dither, so the new theme arrives square
       by square over the page as it is. Going to light, it plays backwards:
       the dark page shrinks into the button and breaks up square by square.
       Every square shows one page or the other, never a painted colour; a
       lemon sparkle marks each square as it flips.
       On a touch screen the page cross-fades. Without view transitions, or
       when the visitor asks for less motion, it switches at once.
       A click during a switch finishes that one and starts the next from
       the current theme, so the button can be pressed again and again. */
    const WAVE_MS = 720;
    const PIXEL = 10; // one dither square, in CSS px
    const SPAN = 160; // how far the dither reaches ahead of the edge
    // The dither thresholds, 0 to 1: the centre of each of the 64 steps.
    const BAYER = BAYER_8.map((v) => (v + 0.5) / 64);
    let current: ViewTransition | null = null;
    let lastClick = 0;

    /* Returns a frame builder for the dissolve around (x, y). Given the edge
       radius r it paints the lemon sparkle on the canvas and returns the clip
       path for the page on top: the new page while it grows (`grow`), or the
       old page while it shrinks. The path is a smooth disk for the settled
       middle plus one rectangle per run of visible squares in the dither. */
    const dissolve = (
      canvas: HTMLCanvasElement,
      x: number,
      y: number,
      grow: boolean,
    ) => {
      const ctx = canvas.getContext("2d");
      const w = canvas.width;
      const h = canvas.height;
      const img = ctx?.createImageData(w, h);
      const px = img ? new Uint32Array(img.data.buffer) : null;
      // The lemon token as one pixel: ImageData is RGBA bytes, which a
      // little-endian Uint32Array reads as ABGR.
      const n = parseInt(
        getComputedStyle(root).getPropertyValue("--lemon").trim().slice(1),
        16,
      );
      const lemon =
        (0xff000000 |
          ((n & 0xff) << 16) |
          (n & 0xff00) |
          ((n >> 16) & 0xff)) >>>
        0;
      // Both arcs and every rectangle run clockwise, so they add up.
      const disk = (rad: number) =>
        rad > 0
          ? `M${x - rad} ${y}A${rad} ${rad} 0 1 1 ${x + rad} ${y}A${rad} ${rad} 0 1 1 ${x - rad} ${y}Z`
          : "";
      return (r: number) => {
        px?.fill(0);
        const parts = [disk(grow ? r - PIXEL : r - SPAN)];
        for (let j = 0; j < h; j++) {
          const dy = (j + 0.5) * PIXEL - y;
          let run = -1;
          for (let i = 0; i <= w; i++) {
            let show = false;
            if (i < w) {
              const dist = Math.hypot((i + 0.5) * PIXEL - x, dy);
              // How far this square sits ahead of the edge as it moves.
              const d = grow ? dist - r : r - dist;
              if (d > -PIXEL * 2 && d <= SPAN + PIXEL) {
                const density = 1 - (d - PIXEL) / (SPAN - PIXEL);
                const at = BAYER[(j & 7) * 8 + (i & 7)];
                const flipped = d <= PIXEL || at < density;
                // Growing shows the new page where flipped; shrinking keeps
                // the old page where not flipped yet.
                show = grow ? flipped : !flipped && d > PIXEL;
                if (px && d > PIXEL && at < density && density - at < 0.1)
                  px[j * w + i] = lemon;
              }
            }
            if (show && run < 0) run = i;
            if (!show && run >= 0) {
              const len = (i - run) * PIXEL;
              parts.push(
                `M${run * PIXEL} ${j * PIXEL}h${len}v${PIXEL}h${-len}z`,
              );
              run = -1;
            }
          }
        }
        if (ctx && img) ctx.putImageData(img, 0, 0);
        return parts.join("") || "M0 0";
      };
    };

    const press = (e: MouseEvent) => {
      const still = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (!document.startViewTransition || still.matches) {
        apply();
        return;
      }
      /* A pointer double-tap inside 120ms counts once; a key press always
         counts (a keyboard click has detail 0). */
      const now = performance.now();
      if (e.detail > 0 && now - lastClick < 120) return;
      lastClick = now;
      current?.skipTransition();
      document.getElementById("theme-ring")?.remove();
      document.getElementById("theme-clip")?.remove();

      const touch = window.matchMedia("(hover: none) and (pointer: coarse)");
      const mode = touch.matches ? "theme-fade" : "theme-circle";
      const grow = !root.classList.contains("dark");
      root.classList.remove("theme-fade", "theme-circle", "theme-shrink");
      root.classList.add(mode);
      if (mode === "theme-circle" && !grow) root.classList.add("theme-shrink");

      const r = btn.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const far = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );
      // Each way starts and ends with the dither just off-screen.
      const [from, to] = grow ? [0, far + PIXEL * 2] : [far + SPAN, 0];
      const pseudo = grow
        ? "::view-transition-new(root)"
        : "::view-transition-old(root)";
      let ring: HTMLElement | null = null;
      let clip: HTMLStyleElement | null = null;
      let frameAt: ((r: number) => string) | null = null;
      const t = document.startViewTransition(() => {
        apply();
        if (mode !== "theme-circle") return;
        ring = document.createElement("div");
        ring.id = "theme-ring";
        ring.setAttribute("aria-hidden", "true");
        const canvas = document.createElement("canvas");
        canvas.width = Math.ceil(window.innerWidth / PIXEL);
        canvas.height = Math.ceil(window.innerHeight / PIXEL);
        canvas.style.width = `${canvas.width * PIXEL}px`;
        canvas.style.height = `${canvas.height * PIXEL}px`;
        ring.append(canvas);
        document.body.append(ring);
        frameAt = dissolve(canvas, x, y, grow);
        // The first frame is in place before the pages are drawn.
        clip = document.createElement("style");
        clip.id = "theme-clip";
        clip.textContent = `${pseudo}{clip-path:path("${frameAt(from)}")}`;
        document.head.append(clip);
      });
      current = t;
      t.finished.finally(() => {
        if (current !== t) return; // a newer switch owns the page now
        current = null;
        root.classList.remove(mode, "theme-shrink");
        document.getElementById("theme-ring")?.remove();
        document.getElementById("theme-clip")?.remove();
      });
      if (mode !== "theme-circle") return;

      const timing = {
        duration: WAVE_MS,
        easing: "cubic-bezier(0.45, 0, 0.2, 1)",
        fill: "forwards" as const,
      };
      t.ready
        .then(() => {
          const el = ring as HTMLElement | null;
          const sheet = clip as HTMLStyleElement | null;
          const build = frameAt as ((r: number) => string) | null;
          if (!el || !sheet || !build) return;
          // The switch lasts as long as an animation on its pages does.
          root.animate(
            { opacity: [1, 1] },
            { ...timing, pseudoElement: "::view-transition-group(root)" },
          );
          /* The radius runs as an animated custom property, and each frame
             builds the clip and the sparkle from its current value. */
          const radius = el.animate(
            { "--ring-r": [`${from}px`, `${to}px`] },
            timing,
          );
          const frame = () => {
            if (!el.isConnected || !sheet.isConnected) return;
            const now = parseFloat(
              getComputedStyle(el).getPropertyValue("--ring-r"),
            );
            sheet.textContent = `${pseudo}{clip-path:path("${build(now)}")}`;
            if (radius.playState !== "finished") requestAnimationFrame(frame);
          };
          frame();
        })
        .catch(() => {
          // Skipped by a newer click before it started; nothing to animate.
        });
    };
    btn.addEventListener("click", press);
    /* While a switch runs, the browser sends every click to <html>, not to
       the button. A click there that lands on the button still counts. */
    document.addEventListener("click", (e) => {
      if (!current || e.target !== root) return;
      const b = btn.getBoundingClientRect();
      const inside =
        e.clientX >= b.left &&
        e.clientX <= b.right &&
        e.clientY >= b.top &&
        e.clientY <= b.bottom;
      if (inside) press(e);
    });
  }
  initThemeToggle();
</script>
