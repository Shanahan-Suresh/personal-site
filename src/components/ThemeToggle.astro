---
/* The theme switch's button. src/scripts/home/theme.ts runs the switch. */
import { BAYER_8 } from "@/lib/bayer";
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  aria-pressed="false"
  class="theme-btn"
>
  <!-- 8 x 8 ordered dither (Bayer): --o is the order each square fills in. -->
  <span class="dither" aria-hidden="true">
    {BAYER_8.map((o) => (
      <i style={`--o:${o}`} />
    ))}
  </span>
  <svg
    id="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg
    id="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
  </svg>
</button>

<style>
  /* A round button, the one owner-approved radius in the nav. Under a mouse
     or keyboard focus it fades in with butter square by square, in an 8 x 8
     ordered dither, the same Bayer pattern as the page dissolve the click
     starts, so the hover is a small preview of the switch. Leaving plays it
     backwards. */
  .theme-btn {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    border: 2px solid var(--white);
    background: none;
    color: var(--white);
    cursor: pointer;
    transition:
      border-color 0s 0.1s,
      color 0s 0.06s;
  }
  /* Both icons sit in one cell. The icon always shows the theme in use;
     a click switches it once, and the hover never previews the other one. */
  .theme-btn svg {
    position: relative;
    grid-area: 1 / 1;
    transition: opacity 0s 0.06s;
  }
  #icon-moon,
  :global(html.dark) #icon-sun {
    opacity: 0;
  }
  :global(html.dark) #icon-moon {
    opacity: 1;
  }
  .dither {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
    display: grid;
    grid-template: repeat(8, 1fr) / repeat(8, 1fr);
    pointer-events: none;
  }
  .dither i {
    background: var(--butter);
    opacity: 0;
    transition: opacity 0s calc((63 - var(--o)) * 4ms);
  }
  .theme-btn:focus-visible,
  .theme-btn:active {
    border-color: var(--butter);
    color: var(--ink);
    transition:
      border-color 0s,
      color 0s 0.1s;
  }
  .theme-btn:focus-visible .dither i,
  .theme-btn:active .dither i {
    opacity: 1;
    transition-delay: calc(var(--o) * 6ms);
  }
  @media (hover: hover) {
    .theme-btn:hover {
      border-color: var(--butter);
      color: var(--ink);
      transition:
        border-color 0s,
        color 0s 0.1s;
    }
    .theme-btn:hover .dither i {
      opacity: 1;
      transition-delay: calc(var(--o) * 6ms);
    }
  }
  /* Press sinks. */
  .theme-btn:active svg {
    transform: translateY(1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-btn,
    .theme-btn:hover,
    .theme-btn:focus-visible,
    .theme-btn:active,
    .dither i,
    .theme-btn:hover .dither i,
    .theme-btn:focus-visible .dither i,
    .theme-btn:active .dither i {
      transition: none;
    }
  }
  @media (max-width: 768px) {
    .theme-btn {
      width: 44px;
      height: 44px;
    }
  }
</style>
