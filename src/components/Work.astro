---
import ProjectRow from "./ProjectRow.astro";
import ProjectStory from "./ProjectStory.astro";
import { projects } from "@/data/projects";
---

<section id="work" class="slab s-green">
  <div class="wrap work">
    <h2 class="huge reveal">
      <span class="ln"><span>Things I've</span></span>
      <span class="ln"><span>built</span></span>
    </h2>
    <ul class="projects" role="list">
      {projects.map((p) => <ProjectRow project={p} />)}
    </ul>
  </div>
  {
    projects.map((p, i) => (
      <ProjectStory
        project={p}
        prev={projects[(i - 1 + projects.length) % projects.length]}
        next={projects[(i + 1) % projects.length]}
      />
    ))
  }
</section>
<div id="peek" aria-hidden="true">
  <span class="peek-pics"></span><span class="peek-cap"></span>
</div>

<style>
  .work {
    padding-block: 80px 88px;
  }
  .huge {
    margin-bottom: 48px;
    font-size: clamp(76px, 16vw, 240px);
  }
  .projects {
    margin: 0 -20px;
    padding: 0;
    list-style: none;
    border-top: var(--seam) solid var(--white);
  }

  #peek {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: 400px;
    pointer-events: none;
    border: var(--seam) solid var(--ink);
    box-shadow: var(--hard-8) var(--ink);
    background: var(--white);
    opacity: 0;
    transition: opacity var(--dur-fast);
    will-change: transform;
  }
  #peek.on {
    opacity: 1;
  }
  /* Pictures stack: a new one wipes in over the last, which stays until it
     is covered, so a change of row never shows an empty frame. */
  .peek-pics {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .peek-pics :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  /* The capture's caption rides on the frame's top edge as a butter tab. */
  .peek-cap {
    position: absolute;
    left: -3px;
    bottom: calc(100% + 3px);
    max-width: calc(100% + 6px);
    padding: 6px 9px 5px;
    border: var(--seam) solid var(--ink);
    background: var(--butter);
    color: var(--ink);
    font: 500 11.5px/1.2 var(--font-mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .peek-cap:empty {
    display: none;
  }
  @media not all and (hover: hover) and (pointer: fine), (max-width: 960px) {
    #peek {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .work {
      padding-block: 56px 64px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #peek {
      transition: none;
    }
  }
</style>
