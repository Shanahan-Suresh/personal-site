---
import ProjectRow from "./ProjectRow.astro";
import ProjectStory from "./ProjectStory.astro";
import { projects } from "@/data/projects";
---

<section id="work" class="slab s-green">
  <div class="wrap work">
    <div class="work-top">
      <h2 class="huge reveal">
        <span class="ln"><span>Things I've</span></span>
        <span class="ln"><span>built</span></span>
      </h2>
      <p>
        Seven projects from work, side projects and university. Open any row for
        the full story.
      </p>
    </div>
    <ul class="projects" role="list">
      {projects.map((p, i) => <ProjectRow project={p} index={i} />)}
    </ul>
  </div>
  {
    projects.map((p, i) => (
      <ProjectStory
        project={p}
        index={i}
        total={projects.length}
        prev={projects[(i - 1 + projects.length) % projects.length]}
        next={projects[(i + 1) % projects.length]}
      />
    ))
  }
</section>
<div id="peek" aria-hidden="true">
  <img alt="" decoding="async" /><span class="peek-cap"></span>
</div>

<style>
  .work {
    padding-block: 80px 88px;
  }
  .work-top {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
  }
  .huge {
    margin-bottom: 48px;
    font-size: clamp(76px, 16vw, 240px);
  }
  .work-top p {
    max-width: 30ch;
    margin: 0 0 48px;
    font-size: 18px;
  }
  .projects {
    margin: 0 -20px;
    padding: 0;
    list-style: none;
    border-top: var(--seam) solid var(--white);
  }

  #peek {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: 400px;
    pointer-events: none;
    border: var(--seam) solid var(--ink);
    box-shadow: var(--hard-8) var(--ink);
    background: var(--white);
    opacity: 0;
    transition: opacity var(--dur-fast);
    will-change: transform;
  }
  #peek.on {
    opacity: 1;
  }
  #peek img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  #peek:not(.on) img:not([src]) {
    visibility: hidden;
  }
  /* The capture's caption rides on the frame's top edge as a butter tab. */
  .peek-cap {
    position: absolute;
    left: -3px;
    bottom: calc(100% + 3px);
    max-width: calc(100% + 6px);
    padding: 6px 9px 5px;
    border: var(--seam) solid var(--ink);
    background: var(--butter);
    color: var(--ink);
    font: 500 11.5px/1.2 var(--font-mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .peek-cap:empty {
    display: none;
  }
  /* A new picture wipes down from the top, so a change of row reads as one move. */
  @media (prefers-reduced-motion: no-preference) {
    #peek.wipe img {
      animation: peek-wipe 0.32s var(--ease-out);
    }
    @keyframes peek-wipe {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }
  @media not all and (hover: hover) and (pointer: fine), (max-width: 960px) {
    #peek {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .work-top {
      display: block;
    }
  }
  @media (max-width: 560px) {
    .work {
      padding-block: 56px 64px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #peek {
      transition: none;
    }
  }
</style>
