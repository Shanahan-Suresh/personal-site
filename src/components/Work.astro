---
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";
import { categories, accentCycle } from "@/data/projects";

const CARD_STAGGER_MS = 60; /* ms per card index — matches STAGGER_STEP_DEFAULT in BaseLayout only for this section */

let offset = 0;
const numberedCategories = categories.map((cat) => {
  const start = offset;
  offset += cat.items.length;
  return { ...cat, start };
});
---

<section id="work" class="section-lg">
  <div class="container">
    <SectionHeading
      eyebrow="SELECTED WORK"
      title="A few things I've built"
      intro="Mix of things I shipped at work, plus stuff outside it too."
    />

    <div class="stack" style="gap:var(--space-8);">
      {
        numberedCategories.map((cat) => (
          <div>
            <div class="section-label">{cat.label}</div>
            <div class="grid-2">
              {cat.items.map((p, j) => {
                const idx = cat.start + j;
                const num = String(idx + 1).padStart(2, "0");
                const accent =
                  p.accent ?? accentCycle[idx % accentCycle.length];
                return (
                  <ProjectCard
                    project={p}
                    num={num}
                    accent={accent}
                    class="reveal"
                    style={`--d:${idx * CARD_STAGGER_MS}ms`}
                  />
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
