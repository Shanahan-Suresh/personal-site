---
import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import antonWoff2 from "@fontsource/anton/files/anton-latin-400-normal.woff2?url";
import archivoWoff2 from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import dmMono400 from "@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url";
import dmMono500 from "@fontsource/dm-mono/files/dm-mono-latin-500-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const { title, description, image, canonical } = Astro.props;

const fontFaces = `
@font-face{font-family:'Anton';font-style:normal;font-display:swap;font-weight:400;src:url(${antonWoff2}) format('woff2')}
@font-face{font-family:'Archivo Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${archivoWoff2}) format('woff2-variations')}
@font-face{font-family:'DM Mono';font-style:normal;font-display:swap;font-weight:400;src:url(${dmMono400}) format('woff2')}
@font-face{font-family:'DM Mono';font-style:normal;font-display:swap;font-weight:500;src:url(${dmMono500}) format('woff2')}
`.trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={antonWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={archivoWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline set:html={fontFaces}></style>
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          /* theme */
          var storedTheme = localStorage.getItem("theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          if (storedTheme === "dark" || (!storedTheme && prefersDark)) {
            root.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      canonical={canonical}
    />
  </head>
  <body>
    <div class="app-shell">
      <Nav />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <script is:inline>
      (function () {
        var STAGGER_STEP_DEFAULT = 70; /* ms — default data-stagger value */
        var HERO_ALIVE_DELAY = 1400; /* ms — delay before hero idle motion starts */

        var reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        var teardowns = [];

        function cleanup() {
          teardowns.forEach(function (fn) {
            try {
              fn();
            } catch (e) {}
          });
          teardowns = [];
        }

        /* Scroll-reveal: variants via data-reveal; --d per element or auto per child */
        function initReveal() {
          /* auto-stagger: tag direct children + assign --d by index */
          document
            .querySelectorAll('.reveal[data-reveal="stagger-children"]')
            .forEach(function (container) {
              var step = parseInt(
                container.getAttribute("data-stagger") || String(STAGGER_STEP_DEFAULT),
                10,
              );
              Array.prototype.forEach.call(
                container.children,
                function (child, i) {
                  child.classList.add("reveal-child");
                  if (!child.style.getPropertyValue("--d")) {
                    child.style.setProperty("--d", i * step + "ms");
                  }
                },
              );
            });

          var els = document.querySelectorAll(".reveal");
          if (reduce || !("IntersectionObserver" in window)) {
            els.forEach(function (el) {
              el.classList.add("is-visible");
            });
            return;
          }
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add("is-visible");
                  io.unobserve(e.target);
                }
              });
            },
            // threshold: 0 (not 0.08) is intentional — clip-wipe reveals start at
            // clip-path: inset(0 100% 0 0), which zeroes the element's intersection
            // area so its ratio is permanently 0. A non-zero threshold could never
            // fire for them, so they'd stay clipped forever. threshold 0 fires on
            // isIntersecting (entry), and the -8% rootMargin still gates timing.
            { rootMargin: "0px 0px -8% 0px", threshold: 0 },
          );
          els.forEach(function (el) {
            io.observe(el);
          });
          teardowns.push(function () {
            io.disconnect();
          });
        }

        /* Hero entrance plays on load (not scroll); idle motion starts after */
        function initHero() {
          var hero = document.querySelector(".hero-section");
          if (!hero) return;
          if (reduce) {
            hero.classList.add("hero-loaded");
            document.dispatchEvent(new CustomEvent("hero:headline-done"));
            return;
          }
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              hero.classList.add("hero-loaded");
            });
          });
          var t = setTimeout(function () {
            hero.classList.add("is-alive");
          }, HERO_ALIVE_DELAY);
          teardowns.push(function () {
            clearTimeout(t);
          });
        }

        /* Scrollspy: highlight the nav link whose section is in view */
        function initScrollSpy() {
          if (!("IntersectionObserver" in window)) return;
          var links = Array.prototype.slice.call(
            document.querySelectorAll(".nav-link"),
          );
          var map = {};
          links.forEach(function (a) {
            var href = a.getAttribute("href") || "";
            var i = href.indexOf("#");
            if (i !== -1) {
              var id = href.slice(i + 1);
              if (id) map[id] = a;
            }
          });
          var ids = Object.keys(map);
          if (!ids.length) return;
          var sections = ids
            .map(function (id) {
              return document.getElementById(id);
            })
            .filter(Boolean);
          if (!sections.length) return;

          function clearActive() {
            links.forEach(function (a) {
              a.classList.remove("is-active");
              a.removeAttribute("aria-current");
            });
          }
          var spy = new IntersectionObserver(
            function (entries) {
              var best = null;
              entries.forEach(function (e) {
                if (
                  e.isIntersecting &&
                  (!best || e.intersectionRatio > best.intersectionRatio)
                ) {
                  best = e;
                }
              });
              if (best) {
                clearActive();
                var a = map[best.target.id];
                if (a) {
                  a.classList.add("is-active");
                  a.setAttribute("aria-current", "true");
                }
              }
            },
            { rootMargin: "-45% 0px -45% 0px", threshold: [0, 0.25, 0.5, 1] },
          );
          sections.forEach(function (s) {
            spy.observe(s);
          });
          teardowns.push(function () {
            spy.disconnect();
          });
        }

        /* Scrolled-nav: deepen the header shadow once the page scrolls */
        function initScrolledNav() {
          var header = document.querySelector(".nav-header");
          if (!header || !("IntersectionObserver" in window)) return;
          var sentinel = document.createElement("div");
          sentinel.setAttribute("aria-hidden", "true");
          sentinel.style.cssText =
            "position:absolute;top:8px;left:0;width:1px;height:1px;pointer-events:none;";
          document.body.appendChild(sentinel);
          var obs = new IntersectionObserver(
            function (entries) {
              header.classList.toggle("is-scrolled", !entries[0].isIntersecting);
            },
            { threshold: 0 },
          );
          obs.observe(sentinel);
          teardowns.push(function () {
            obs.disconnect();
            if (sentinel.parentNode) sentinel.parentNode.removeChild(sentinel);
          });
        }

        /* Pause idle loops while offscreen */
        function initIdlePause() {
          if (!("IntersectionObserver" in window)) return;
          var targets = document.querySelectorAll(".sticker-cluster, .marquee");
          if (!targets.length) return;
          var pauseObs = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                e.target.classList.toggle("is-paused", !e.isIntersecting);
              });
            },
            { threshold: 0 },
          );
          targets.forEach(function (t) {
            pauseObs.observe(t);
          });
          teardowns.push(function () {
            pauseObs.disconnect();
          });
        }

        function init() {
          cleanup();
          initReveal();
          initHero();
          initScrollSpy();
          initScrolledNav();
          initIdlePause();
        }
        init();
        document.addEventListener("astro:page-load", init);
        document.addEventListener("astro:before-swap", cleanup);
      })();
    </script>
  </body>
</html>
