---
import BaseLayout from './BaseLayout.astro';
import { formatPostDateLong } from '../lib/posts';

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  tags?: string[];
  canonicalUrl?: string;
}

const { title, description, pubDate, tags, canonicalUrl } = Astro.props;
const formattedDate = pubDate ? formatPostDateLong(pubDate) : null;
---

<BaseLayout title={`${title} — Shanahan Suresh`} description={description} canonical={canonicalUrl}>
  <div class="container section">
    <div class="narrow">
      <header style="margin-bottom:var(--space-8);">
        <a href="/writing" class="btn btn-ghost" style="margin-bottom:var(--space-5);">← Writing</a>
        <h1 class="h1">{title}</h1>
        {description && <p class="lead" style="margin-top:var(--space-4);">{description}</p>}
        <div class="row-wrap gap-3" style="margin-top:var(--space-5);">
          {formattedDate && <time class="mono muted">{formattedDate}</time>}
          {tags && tags.length > 0 && tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
        <hr style="border:none;border-top:var(--border-thick);margin-top:var(--space-6);" />
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
