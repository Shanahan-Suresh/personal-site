---
import BaseLayout from "./BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import { formatPostDateLong } from "../lib/posts";

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  tags?: string[];
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  pubDate,
  tags,
  canonicalUrl,
  noindex = false,
} = Astro.props;
const formattedDate = pubDate ? formatPostDateLong(pubDate) : null;
---

<BaseLayout
  title={`${title} — Shanahan Suresh`}
  description={description}
  canonical={canonicalUrl}
  noindex={noindex}
>
  <PageHead
    label={formattedDate ?? "Writing"}
    title={title}
    intro={description}
  >
    <a slot="before" href="/writing" class="back">
      ← Writing
    </a>
    {tags && tags.length > 0 && (
      <ul class="tags chips" role="list">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )}
  </PageHead>
  <article class="slab s-paper">
    <div class="wrap">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 28px;
    font: 500 13px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 4px;
  }
  .tags {
    margin: 24px 0 0;
  }
</style>
