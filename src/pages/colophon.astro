---
import { execFileSync } from "node:child_process";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import { site } from "@/lib/site-config";
import {
  measuredOn,
  repoFile,
  stack,
  stats,
  writingElsewhere,
} from "@/data/colophon";

// Ask Playwright to expand parameterized cases and every configured browser.
interface TestSuite {
  suites?: TestSuite[];
  specs?: { tests: unknown[] }[];
}
const listing = JSON.parse(
  execFileSync(
    process.execPath,
    [
      join(process.cwd(), "node_modules/@playwright/test/cli.js"),
      "test",
      "--list",
      "--reporter=json",
    ],
    { encoding: "utf8" },
  ),
);
const countTests = (suites: TestSuite[]): number =>
  suites.reduce(
    (total, suite) =>
      total +
      (suite.specs?.reduce((n, spec) => n + spec.tests.length, 0) ?? 0) +
      countTests(suite.suites ?? []),
    0,
  );
const testCount = countTests(listing.suites);
---

<BaseLayout
  title="Colophon — Shanahan Suresh"
  description="shanahansuresh.com is built with Astro 7 and Tailwind 4, with no framework JavaScript, and tested with Playwright in three browsers."
>
  <PageHead
    label="Colophon"
    title="How this site is built"
    intro="The code for this site is on GitHub. Each tool in the first list links to the file where the site uses it."
  />

  <section class="slab s-paper">
    <div class="wrap split">
      <h2>What it runs on</h2>
      <div>
        <p class="body">
          A personal site should load fast, so there is no framework runtime on
          the page. Astro renders everything to HTML at build time. The styling
          is a hand-written token system on top of Tailwind 4. The only
          JavaScript is one small module for the interactive bits (the headline
          reveal, the pointer preview on the projects and the story dialogs).
        </p>
        <ul class="ruled" role="list">
          {
            stack.map((item) => (
              <li>
                <span class="name">
                  {item.path ? (
                    <a
                      href={repoFile(item.path)}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.name}
                    </a>
                  ) : (
                    item.name
                  )}
                </span>
                <span class="detail">{item.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="slab s-butter" aria-labelledby="numbers-title">
    <div class="wrap numbers-head">
      <h2 id="numbers-title">By the numbers</h2>
      <span class="label">Measured {measuredOn}</span>
    </div>
    <ul class="wrap stats" role="list">
      {
        stats.map((s) => (
          <li>
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
            {s.note && <span class="stat-note">{s.note}</span>}
          </li>
        ))
      }
      <li>
        <span class="stat-value">{testCount}</span>
        <span class="stat-label">End-to-end checks</span>
        <span class="stat-note"
          >Cases across the three-browser matrix, counted at build time</span
        >
      </li>
    </ul>
  </section>

  <section class="slab s-paper">
    <ul class="wrap cols" role="list">
      <li>
        <span class="label">Design system</span>
        <h2>Colour slabs and ink seams</h2>
        <p>
          Full-width colour slabs joined by 3px ink seams, condensed display
          type, and hard shadows only on the things you can press or open. Text
          on each slab is fixed to its colour, so the dark theme deepens the
          slabs and inverts only the paper.
        </p>
        <p>
          Every animation waits for <code
            >prefers-reduced-motion: no-preference</code
          >. With script off, every headline sits in place and every project
          story still opens.
        </p>
        <ul class="chips" role="list">
          <li>tokens.css</li>
          <li>components.css</li>
          <li>motion.css</li>
          <li>prose.css</li>
        </ul>
      </li>
      <li>
        <span class="label">Testing and shipping</span>
        <h2>Tests and hosting</h2>
        <p>
          <code>npm run build</code> type-checks first, so a type error stops the
          deploy. Playwright runs the suite against the built output in Chromium,
          Firefox and WebKit, including a performance budget of 350 KiB on arrival
          and 1.5 MiB after scrolling through every section.
        </p>
        <p>
          Cloudflare Pages serves the static output behind CSP, HSTS and
          Permissions-Policy headers. The footer on every page links to the
          exact commit it was built from.
        </p>
        <ul class="chips" role="list">
          <li>astro check</li>
          <li>Playwright</li>
          <li>Prettier</li>
          <li>GitHub Actions</li>
        </ul>
      </li>
    </ul>
  </section>

  <section class="slab s-green">
    <div class="wrap elsewhere">
      <span class="label">Writing elsewhere</span>
      <h2>
        <a
          href={writingElsewhere.href}
          target="_blank"
          rel="noopener noreferrer">{writingElsewhere.title} ↗</a
        >
      </h2>
      <p class="label meta">{writingElsewhere.meta}</p>
      <div class="actions">
        <a
          class="btn"
          href={writingElsewhere.repo.href}
          target="_blank"
          rel="noopener noreferrer">{writingElsewhere.repo.label} ↗</a
        >
        <a
          class="btn btn-alt"
          href={site.repo}
          target="_blank"
          rel="noopener noreferrer">This site's source ↗</a
        >
        <a
          class="btn btn-alt"
          href={repoFile("src/pages/colophon.astro")}
          target="_blank"
          rel="noopener noreferrer">This page's source ↗</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 56px;
    align-items: start;
    padding-block: 72px 80px;
  }
  h2 {
    font-size: clamp(40px, 5vw, 72px);
  }
  .body {
    max-width: 60ch;
    margin: 0 0 28px;
    font-size: 18.5px;
  }
  .ruled {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--seam) solid var(--edge);
  }
  .ruled li {
    display: grid;
    grid-template-columns: minmax(9rem, 13rem) minmax(0, 1fr);
    gap: 20px;
    padding-block: 16px;
    border-bottom: 1px solid var(--edge);
  }
  .name {
    font: 800 22px/1.1 var(--font-display);
    text-transform: uppercase;
  }
  .name a {
    text-decoration: none;
    border-bottom: 3px solid var(--butter);
  }
  .name a:hover {
    background: var(--butter);
    color: var(--ink);
  }
  .detail {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
  }

  .numbers-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 56px 32px;
  }
  /* Ink shows through the gaps as seams between the cells. */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--seam);
    margin-block: 0 64px;
    list-style: none;
    background: var(--ink);
    background-clip: content-box;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 26px 28px 30px;
    background: var(--butter);
  }
  .stats li:nth-child(3n + 1) {
    padding-left: 0;
  }
  .stat-value {
    font: 800 clamp(40px, 5vw, 72px) / 0.95 var(--font-display);
    letter-spacing: 0.008em;
  }
  .stat-label {
    font-weight: 700;
    font-size: 17px;
  }
  .stat-note {
    max-width: 30ch;
    font-size: 15px;
    line-height: 1.4;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block: 0;
    list-style: none;
  }
  .cols > li {
    padding: 56px 40px 64px;
    border-left: var(--seam) solid var(--edge);
  }
  .cols > li:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .cols > li:last-child {
    padding-right: 0;
  }
  .cols h2 {
    margin: 16px 0 20px;
    font-size: clamp(36px, 4vw, 56px);
  }
  .cols p {
    max-width: 52ch;
    margin: 0 0 16px;
    font-size: 17.5px;
  }
  code {
    padding: 0.05em 0.35em;
    border: 2px solid var(--edge);
    font: 500 0.84em/1.3 var(--font-mono);
  }
  .chips {
    margin: 24px 0 0;
  }

  .elsewhere {
    padding-block: 64px 72px;
  }
  .elsewhere h2 {
    max-width: 22ch;
    margin-top: 16px;
    font-size: clamp(36px, 4.6vw, 64px);
  }
  .elsewhere h2 a {
    text-decoration: none;
  }
  .elsewhere h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-underline-offset: 0.12em;
  }
  .meta {
    margin: 18px 0 28px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .actions .btn {
    white-space: normal;
  }

  @media (max-width: 960px) {
    .split,
    .cols {
      grid-template-columns: 1fr;
    }
    .split {
      gap: 28px;
    }
    .cols > li,
    .cols > li:last-child {
      padding: 40px 0;
      border-left: 0;
      border-top: var(--seam) solid var(--edge);
    }
    .cols > li:first-child {
      border-top: 0;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats li:nth-child(3n + 1) {
      padding-left: 28px;
    }
    .stats li:nth-child(2n + 1) {
      padding-left: 0;
    }
  }
  @media (max-width: 560px) {
    .split {
      padding-block: 48px 56px;
    }
    .ruled li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .stats {
      grid-template-columns: 1fr;
    }
    .stats li,
    .stats li:nth-child(3n + 1) {
      padding-left: 0;
    }
  }
</style>
