---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import About from '../components/About.astro';
import Principles from '../components/Principles.astro';
import Now from '../components/Now.astro';
import Work from '../components/Work.astro';
import Beyond from '../components/Beyond.astro';
import Contact from '../components/Contact.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getPublishedPosts } from '../lib/posts';
import PostCard from '../components/PostCard.astro';

const recentPosts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout
  title="Shanahan Suresh — product-minded software engineer"
  description="Shanahan Suresh, a software engineer and University of Nottingham Computer Science graduate who builds full-stack products and AI tooling people enjoy using."
>
  <Hero />
  <Marquee />
  <About />
  <Principles />
  <Now />
  <Work />
  <Beyond />

  {recentPosts.length > 0 && (
    <section id="writing" class="section">
      <div class="container">
        <div class="row-wrap between reveal" style="align-items:flex-end;gap:var(--space-4);margin-bottom:var(--space-7);">
          <div>
            <p class="section-label">WRITING</p>
            <h2 class="section-title">Writing</h2>
          </div>
          <a href="/writing" class="btn btn-ghost">All posts →</a>
        </div>

        <div class="stack gap-4">
          {recentPosts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <Contact />
</BaseLayout>
