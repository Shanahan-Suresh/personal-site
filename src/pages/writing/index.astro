---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Writing — Shanahan Suresh"
  description="Working notes on full-stack engineering, AI and MCP tooling, and what it's like to build in the open."
  noindex
>
  <PageHead
    title="Writing"
    intro="Working notes on building software: full-stack patterns, AI and MCP tooling, and the messy parts of shipping it."
  />
  <section class="slab s-paper">
    <ul class="wrap posts" role="list">
      {posts.map((post) => (
        <PostCard post={post} showTags />
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .posts {
    margin-block: 0;
    padding-block: 48px 72px;
    list-style: none;
  }
</style>
